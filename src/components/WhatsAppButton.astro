---
interface Props {
  label?: string;
  message?: string;
  variant?: 'primary' | 'whatsapp' | 'secondary' | 'outline';
  size?: 'md' | 'lg' | 'sm';
  class?: string;
  showIcon?: boolean;
}

const {
  label = 'Hubungi MagangPro',
  message = 'Halo MagangPro, saya ingin bertanya tentang program magang.',
  variant = 'whatsapp',
  size = 'md',
  class: className = '',
  showIcon = true,
} = Astro.props;

// PRD Section 11: Nomor resmi +62 895-6390-68080
const cleanPhone = '62895639068080';
const whatsappUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`;

const variantClass = {
  primary: 'mp-button--primary',
  whatsapp: 'mp-button--whatsapp',
  secondary: 'mp-button--secondary',
  outline: 'mp-button--outline',
}[variant];

const sizeClass = size === 'lg' ? 'btn-lg' : size === 'sm' ? 'btn-sm' : '';
---

<a
  href={whatsappUrl}
  class={`mp-button ${variantClass} ${sizeClass} ${className}`.trim()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${label} via WhatsApp`}
>
  {showIcon && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.954.558 3.784 1.527 5.334L2 22l4.821-1.503a9.99 9.99 0 0 0 5.21 1.464c5.536 0 10.031-4.495 10.031-10.031S17.567 2 12.031 2zm0 18.239a8.17 8.17 0 0 1-4.354-1.248l-.312-.186-2.868.895.895-2.868-.186-.312A8.188 8.188 0 0 1 3.824 12.03c0-4.526 3.681-8.207 8.207-8.207 4.526 0 8.207 3.681 8.207 8.207 0 4.526-3.681 8.208-8.207 8.208zm4.512-6.177c-.247-.124-1.464-.722-1.691-.805-.227-.082-.392-.124-.557.124-.165.247-.64 1.052-.784 1.217-.144.165-.289.186-.536.062-.247-.124-1.045-.385-1.99-1.228-.736-.656-1.233-1.466-1.377-1.713-.144-.247-.015-.381.108-.504.112-.11.247-.289.371-.433.124-.144.165-.247.247-.412.082-.165.041-.309-.021-.433-.062-.124-.557-1.34-.763-1.836-.2-.485-.404-.419-.557-.426l-.474-.008c-.165 0-.433.062-.66.309-.227.247-.866.846-.866 2.063s.887 2.393 1.01 2.558c.124.165 1.745 2.665 4.228 3.738.591.256 1.052.409 1.411.523.593.189 1.133.162 1.559.098.476-.071 1.464-.598 1.67-1.176.206-.577.206-1.072.144-1.176-.062-.103-.227-.165-.474-.289z" />
    </svg>
  )}
  <span>{label}</span>
</a>

<style>
  .btn-lg {
    min-height: 54px;
    padding: 15px 30px;
    font-size: 1.0625rem;
  }
  .btn-sm {
    min-height: 40px;
    padding: 8px 16px;
    font-size: 0.875rem;
  }
  .mp-button--outline {
    background-color: transparent;
    border: 2px solid var(--mp-red);
    color: var(--mp-red);
  }
  .mp-button--outline:hover {
    background-color: var(--mp-red);
    color: #fff;
  }
</style>
