---
// Floating WhatsApp Button & Back to Top Button
const cleanPhone = '62895639068080';
const defaultMessage = 'Halo MagangPro, saya ingin konsultasi mengenai program magang / pelatihan.';
const whatsappUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(defaultMessage)}`;
---

<div class="mp-floating-actions" id="mp-floating-actions" aria-label="Aksi Cepat">
  <!-- Go to Top Button (Diatas Floating WA) -->
  <button
    type="button"
    class="floating-btn floating-top-btn"
    id="btn-scroll-top"
    aria-label="Kembali ke atas halaman"
    title="Kembali ke atas"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
    <span class="floating-tooltip">Ke Atas</span>
  </button>

  <!-- Floating WhatsApp Button -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="floating-btn floating-wa-btn"
    id="btn-floating-wa"
    aria-label="Hubungi WhatsApp MagangPro (+62 895-6390-68080)"
    title="Chat WhatsApp Admin"
  >
    <!-- Pulse Ring Animation -->
    <span class="wa-pulse-ring" aria-hidden="true"></span>

    <!-- WhatsApp SVG Icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="30"
      height="30"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12.031 2C6.495 2 2 6.495 2 12.031c0 1.954.558 3.784 1.527 5.334L2 22l4.821-1.503a9.99 9.99 0 0 0 5.21 1.464c5.536 0 10.031-4.495 10.031-10.031S17.567 2 12.031 2zm0 18.239a8.17 8.17 0 0 1-4.354-1.248l-.312-.186-2.868.895.895-2.868-.186-.312A8.188 8.188 0 0 1 3.824 12.03c0-4.526 3.681-8.207 8.207-8.207 4.526 0 8.207 3.681 8.207 8.207 0 4.526-3.681 8.208-8.207 8.208zm4.512-6.177c-.247-.124-1.464-.722-1.691-.805-.227-.082-.392-.124-.557.124-.165.247-.64 1.052-.784 1.217-.144.165-.289.186-.536.062-.247-.124-1.045-.385-1.99-1.228-.736-.656-1.233-1.466-1.377-1.713-.144-.247-.015-.381.108-.504.112-.11.247-.289.371-.433.124-.144.165-.247.247-.412.082-.165.041-.309-.021-.433-.062-.124-.557-1.34-.763-1.836-.2-.485-.404-.419-.557-.426l-.474-.008c-.165 0-.433.062-.66.309-.227.247-.866.846-.866 2.063s.887 2.393 1.01 2.558c.124.165 1.745 2.665 4.228 3.738.591.256 1.052.409 1.411.523.593.189 1.133.162 1.559.098.476-.071 1.464-.598 1.67-1.176.206-.577.206-1.072.144-1.176-.062-.103-.227-.165-.474-.289z" />
    </svg>

    <!-- Tooltip badge -->
    <span class="floating-tooltip">Chat WhatsApp</span>
  </a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollTopBtn = document.getElementById('btn-scroll-top');

    if (!scrollTopBtn) return;

    // Show button when scrolled past 260px
    const handleScroll = () => {
      if (window.scrollY > 260) {
        scrollTopBtn.classList.add('is-visible');
      } else {
        scrollTopBtn.classList.remove('is-visible');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Initial check

    // Smooth scroll back to top
    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });
  });
</script>

<style>
  /* Fixed Bottom-Right Stack Container */
  .mp-floating-actions {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    pointer-events: none; /* children enable pointer events */
  }

  @media (max-width: 640px) {
    .mp-floating-actions {
      right: 16px;
      bottom: 16px;
      gap: 10px;
    }
  }

  /* Base Floating Button */
  .floating-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    cursor: pointer;
    text-decoration: none;
    border: none;
    outline: none;
    pointer-events: auto;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.28s ease,
                background-color 0.2s ease,
                color 0.2s ease;
  }

  /* Tooltip on Hover */
  .floating-tooltip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    background: #0f172a;
    color: #ffffff;
    font-family: var(--mp-font-body);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 8px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
    transition: all 0.2s ease;
  }

  .floating-tooltip::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border-width: 5px;
    border-style: solid;
    border-color: transparent transparent transparent #0f172a;
  }

  .floating-btn:hover .floating-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%) translateX(0);
  }

  @media (max-width: 768px) {
    /* Hide tooltips on mobile touch devices */
    .floating-tooltip {
      display: none;
    }
  }

  /* Go to Top Button (Above WhatsApp) */
  .floating-top-btn {
    width: 44px;
    height: 44px;
    background: #ffffff;
    color: #334155;
    border: 1px solid rgba(203, 213, 225, 0.85);
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.14), 0 2px 6px rgba(15, 23, 42, 0.04);
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px) scale(0.85);
    pointer-events: none;
  }

  .floating-top-btn.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .floating-top-btn:hover {
    background: var(--mp-red);
    color: #ffffff;
    border-color: var(--mp-red);
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 12px 28px -4px rgba(198, 40, 40, 0.35);
  }

  /* Floating WhatsApp Button */
  .floating-wa-btn {
    width: 58px;
    height: 58px;
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    color: #ffffff;
    box-shadow: 0 10px 28px -4px rgba(37, 211, 102, 0.45), 0 2px 8px rgba(18, 140, 126, 0.2);
  }

  .floating-wa-btn:hover {
    transform: translateY(-3px) scale(1.06);
    box-shadow: 0 16px 36px -4px rgba(37, 211, 102, 0.58), 0 4px 12px rgba(18, 140, 126, 0.3);
    color: #ffffff;
  }

  /* WhatsApp Soft Pulse Wave */
  .wa-pulse-ring {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.6);
    animation: wa-pulse 2.2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
    pointer-events: none;
  }

  @keyframes wa-pulse {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.22);
      opacity: 0;
    }
    100% {
      transform: scale(1.22);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-pulse-ring {
      animation: none;
      display: none;
    }
    .floating-btn {
      transition: none;
    }
  }
</style>
