---
import { portfolioData } from '../data/portfolio';
import WhatsAppButton from './WhatsAppButton.astro';
---

<section class="mp-section" id="portofolio-galeri">
  <div class="mp-container">
    <div class="section-header">
      <span class="eyebrow">Karya Nyata & Dokumentasi</span>
      <h2 class="heading-lg">Portofolio Karya & Galeri Aktivitas</h2>
      <p>
        Hasil proyek nyata yang dikembangkan peserta magang (SMK & Mahasiswa) serta dokumentasi pendampingan langsung bersama mentor industri di Kota Malang.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="portfolio-filter-bar" role="tablist" aria-label="Filter Portofolio & Galeri">
      <button type="button" class="filter-btn is-active" data-filter="all">Semua ({portfolioData.length})</button>
      <button type="button" class="filter-btn" data-filter="web">Website & App</button>
      <button type="button" class="filter-btn" data-filter="marketing">Digital Marketing</button>
      <button type="button" class="filter-btn" data-filter="design">Desain Grafis</button>
      <button type="button" class="filter-btn" data-filter="galeri">Galeri Kegiatan</button>
    </div>

    <!-- Cards Grid (Luxury Travel / Stay Card Aesthetic from Reference) -->
    <div class="portfolio-grid" id="portfolio-grid">
      {portfolioData.map((item) => (
        <article
          class="luxury-portfolio-card"
          data-category={item.category}
          style={`--card-custom-bg: ${item.cardBg};`}
        >
          <!-- Top Media Area with Dissolve Gradient Overlay -->
          <div class="card-media-box">
            <img
              src={item.image}
              alt={item.title}
              class="card-photo"
              loading="lazy"
              width="600"
              height="400"
            />
            <!-- Top Right Bookmark/Save Icon Badge -->
            <button
              type="button"
              class="card-bookmark-btn"
              aria-label="Simpan Portofolio"
              title="Simpan Karya"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
              </svg>
            </button>
            <div class="card-dissolve-gradient" style={`background: linear-gradient(180deg, rgba(0, 0, 0, 0.02) 0%, rgba(0, 0, 0, 0.25) 45%, ${item.cardBg} 90%, ${item.cardBg} 100%);`}></div>
          </div>

          <!-- Bottom Card Body on Tinted Dark Canvas -->
          <div class="card-body">
            <!-- Row 1: Title and Category Badge -->
            <div class="card-title-row">
              <h3 class="card-heading">{item.title}</h3>
              <span class="card-badge-pill">{item.badge}</span>
            </div>

            <!-- Row 2: Two-line summary -->
            <p class="card-description">{item.summary}</p>

            <!-- Row 3: Meta Tag Pills (Rating, Category, Tech/Format) -->
            <div class="card-meta-pills">
              <span class="meta-pill meta-pill--highlight">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                <span>{item.rating.replace('⭐ ', '')}</span>
              </span>
              <span class="meta-pill">{item.pill1}</span>
              <span class="meta-pill">{item.pill2}</span>
            </div>

            <!-- Row 4: Crisp Full-Width Action Button (Book now style) -->
            <a
              href={`https://wa.me/62895639068080?text=${encodeURIComponent(`Halo MagangPro, saya tertarik menanyakan portofolio: ${item.title}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="card-book-now-btn"
            >
              <span>{item.btnLabel}</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom Showcase Banner -->
    <div class="portfolio-footer-banner">
      <div class="banner-text">
        <h3 class="banner-heading">Ingin Membangun Portofolio Nyata Seperti Ini?</h3>
        <p class="banner-sub">Bergabunglah dalam program magang terstruktur MagangPro dan siapkan bukti keahlian profesional Anda.</p>
      </div>
      <div class="banner-btn">
        <WhatsAppButton
          label="Daftar Magang Sekarang"
          message="Halo MagangPro, saya ingin mendaftar magang dan membangun portofolio proyek riil."
          variant="whatsapp"
          size="md"
        />
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.luxury-portfolio-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const filter = btn.dataset.filter || 'all';

        cards.forEach((card) => {
          const category = card.dataset.category;
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            }, 10);
          } else {
            card.style.opacity = '0';
            card.style.transform = 'translateY(12px)';
            setTimeout(() => {
              card.style.display = 'none';
            }, 250);
          }
        });
      });
    });
  });
</script>

<style>
  /* Filter Tabs */
  .portfolio-filter-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(20px, 3vw, 32px);
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .filter-btn {
    font-family: var(--mp-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--mp-muted);
    background: #ffffff;
    border: 1px solid var(--mp-border);
    border-radius: 9999px;
    padding: 8px 18px;
    cursor: pointer;
    transition: all 180ms ease;
  }

  .filter-btn:hover {
    color: var(--mp-ink);
    border-color: #cbd5e1;
    background: #f8fafc;
  }

  .filter-btn.is-active {
    color: #ffffff;
    background: var(--mp-red);
    border-color: var(--mp-red);
    box-shadow: 0 4px 14px rgba(198, 40, 40, 0.25);
  }

  /* Grid: 3 columns matching the reference screenshot */
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.5vw, 28px);
  }

  @media (max-width: 1024px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Card: Luxury Travel / Stay Aesthetic from Reference */
  .luxury-portfolio-card {
    position: relative;
    background-color: var(--card-custom-bg, #1a222d);
    border-radius: 28px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.25), 0 2px 6px rgba(0, 0, 0, 0.1);
    isolation: isolate;
    transform: translateZ(0);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 320ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 280ms ease,
                opacity 250ms ease;
  }

  .luxury-portfolio-card:hover {
    transform: translateY(-8px) translateZ(0);
    border-color: rgba(255, 255, 255, 0.28);
    box-shadow: 0 26px 54px -12px rgba(0, 0, 0, 0.42), 0 0 0 1px rgba(255, 255, 255, 0.15);
  }

  /* Media Box & Dissolve Gradient */
  .card-media-box {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #0a0e14;
    isolation: isolate;
    contain: paint;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    mask-image: radial-gradient(white, black);
    transform: translateZ(0);
  }

  .card-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: translateZ(0);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .luxury-portfolio-card:hover .card-photo {
    transform: scale(1.06) translateZ(0);
  }

  /* Bookmark Icon Button at Top Right */
  .card-bookmark-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 4;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.36);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .card-bookmark-btn:hover {
    background: #ffffff;
    color: #0f172a;
    transform: scale(1.1);
  }

  /* Dissolve Gradient Overlay that seamlessly connects photo to bottom card color */
  .card-dissolve-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: -4px;
    pointer-events: none;
    z-index: 2;
  }

  /* Card Body */
  .card-body {
    position: relative;
    z-index: 3;
    background-color: var(--card-custom-bg, #1a222d);
    margin-top: -2px;
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  /* Title and Badge Row */
  .card-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .card-heading {
    font-family: var(--mp-font-heading);
    font-size: clamp(1.125rem, 1.4vw, 1.25rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    margin: 0;
  }

  .card-badge-pill {
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #ffffff;
    font-family: var(--mp-font-body);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 9999px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Description */
  .card-description {
    font-family: var(--mp-font-body);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.48;
    margin-bottom: 14px;
  }

  /* Meta Tag Pills Row */
  .card-meta-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: 16px;
  }

  .meta-pill {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
    font-family: var(--mp-font-body);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 4px 11px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  .meta-pill--highlight {
    background: rgba(255, 255, 255, 0.18);
    color: #ffda79;
    border-color: rgba(255, 218, 121, 0.35);
  }

  /* Book now style Action Button */
  .card-book-now-btn {
    background: #ffffff;
    color: #0f172a;
    font-family: var(--mp-font-body);
    font-size: 0.875rem;
    font-weight: 700;
    height: 46px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.22s ease,
                color 0.22s ease,
                box-shadow 0.22s ease;
  }

  .card-book-now-btn:hover {
    background: var(--mp-red);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(198, 40, 40, 0.38);
  }

  /* Bottom Banner */
  .portfolio-footer-banner {
    margin-top: clamp(36px, 5vw, 56px);
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: 24px;
    padding: clamp(24px, 3.5vw, 36px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    box-shadow: 0 16px 36px -10px rgba(15, 23, 42, 0.3);
  }

  @media (max-width: 768px) {
    .portfolio-footer-banner {
      flex-direction: column;
      text-align: center;
    }
  }

  .banner-heading {
    font-family: var(--mp-font-heading);
    font-size: clamp(1.125rem, 1.5vw, 1.35rem);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .banner-sub {
    font-family: var(--mp-font-body);
    font-size: 0.875rem;
    color: #94a3b8;
    margin-bottom: 0;
  }

  .banner-btn {
    flex-shrink: 0;
  }
</style>
