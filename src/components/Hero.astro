---
import WhatsAppButton from './WhatsAppButton.astro';
---

<section class="stodio-hero-section">
  <!-- Full-Bleed Edge-to-Edge Cinematic Hero Canvas (Hampir Satu Layar) -->
  <div class="hero-canvas">
    <!-- Background Image with Ambient Dark Overlay -->
    <div class="hero-bg-layer" aria-hidden="true">
      <img
        src="/images/hero/hero-stodio.webp"
        alt="Creative tech student developer working in modern studio"
        width="1376"
        height="768"
        class="hero-bg-img"
        loading="eager"
        decoding="async"
      />
      <div class="hero-overlay"></div>
    </div>

    <!-- Wide Container for Hero Content (Takes up almost 1 full screen) -->
    <div class="hero-wide-container hero-canvas-inner">
      <!-- Top Area: Eyebrow Tag + Big Headline on the Left -->
      <div class="hero-top-area">
        <div class="hero-top-tag">
          <span class="tag-red-icon">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
              <rect x="2" y="2" width="8" height="8" rx="2"></rect>
              <rect x="14" y="2" width="8" height="8" rx="2"></rect>
              <rect x="2" y="14" width="8" height="8" rx="2"></rect>
              <rect x="14" y="14" width="8" height="8" rx="2"></rect>
            </svg>
          </span>
          <span class="tag-label">Program Magang & Pelatihan Digital</span>
        </div>

        <h1 class="hero-headline">
          Bangun Keterampilan<br />
          Digital & Teknologi<br />
          Bersama MagangPro.
        </h1>
      </div>

      <!-- Lower Area: Description on the Right (Turun ke bawah, tepat di atas tombol CTA) -->
      <div class="hero-lower-area">
        <p class="hero-description">
          Praktik Kerja Lapangan (PKL) SMK, Internship Mahasiswa, dan Pelatihan Digital Marketing Berbasis Proyek Industri Nyata.
        </p>
      </div>

      <!-- Bottom Row: Pillars on the Left, CTA Buttons on the Right (SEJAJAR HORIZONTAL) -->
      <div class="hero-bottom-row">
        <!-- Left Pillars -->
        <div class="hero-bottom-pillars">
          <div class="pillar-item">
            <span class="pillar-plus">+</span>
            <span class="pillar-text">Proyek Industri</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-plus">+</span>
            <span class="pillar-text">Mentoring Teknis</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-plus">+</span>
            <span class="pillar-text">Laporan Resmi</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-plus">+</span>
            <span class="pillar-text">Portofolio Siap Kerja</span>
          </div>
        </div>

        <!-- Right Side-by-side CTA buttons (Sejajar dengan pillars) -->
        <div class="hero-cta-group">
          <WhatsAppButton
            label="Daftar via WhatsApp"
            message="Halo MagangPro, saya ingin mendaftar dan menanyakan kuota program magang."
            variant="primary"
            size="md"
            class="stodio-btn stodio-btn--primary"
            showIcon={true}
          />
          <a href="#program-pilihan" class="stodio-btn stodio-btn--secondary">
            <span>Jelajahi Program</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- 4-Pill Stats Strip (Sesuai Referensi Original: Clean White Cards dengan Sentuhan Warna Merah Brand) -->
  <div class="hero-wide-container stats-strip-container">
    <div class="stats-pills-grid">
      <!-- Pill 1 -->
      <div class="stat-pill-card">
        <span class="pill-label">Kurikulum Terarah</span>
        <strong class="pill-value">100% Proyek Riil</strong>
      </div>

      <!-- Pill 2 -->
      <div class="stat-pill-card">
        <span class="pill-label">Pendampingan</span>
        <strong class="pill-value">Mentor Industri</strong>
      </div>

      <!-- Pill 3 -->
      <div class="stat-pill-card">
        <span class="pill-label">Dukungan Berkas</span>
        <strong class="pill-value">Laporan Resmi</strong>
      </div>

      <!-- Pill 4 -->
      <div class="stat-pill-card">
        <span class="pill-label">Lokasi Pusat</span>
        <strong class="pill-value">Kota Malang</strong>
      </div>
    </div>
  </div>
</section>

<style>
  .stodio-hero-section {
    padding-top: 0;
    padding-bottom: clamp(36px, 5vw, 60px);
    background-color: var(--mp-white);
  }

  /* Wide container to allow headline to push left and description/CTA to push right */
  .hero-wide-container {
    width: 100%;
    max-width: 1560px;
    margin-inline: auto;
    padding-inline: clamp(24px, 4.5vw, 64px);
  }

  /* Full-Bleed Hero Canvas (Edge to Edge, no margin/radius on sides) */
  .hero-canvas {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #060606;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Background Image with Blur Effect & Visibility of person on the right */
  .hero-bg-layer {
    position: absolute;
    inset: -12px; /* Inset to prevent edge fringing when blurred */
    z-index: 1;
    overflow: hidden;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 32%;
    filter: grayscale(25%) blur(12px) brightness(0.9) contrast(1.08);
    transform: scale(1.06);
  }

  /* Overlay: Soft White Translucent Mist (kaya tadi) + Left Dark Mask (Orang kanan terlihat jelas & tidak terlalu buram) */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      /* Soft white translucent mist wash (pendaran kabut putih dari versi yang disukai user) */
      radial-gradient(
        circle at 60% 42%,
        rgba(255, 255, 255, 0.22) 0%,
        rgba(255, 255, 255, 0.06) 45%,
        transparent 75%
      ),
      /* Horizontal contrast mask: Dark on left for text readability, clear on right so the person is visible and not too blurry */
      linear-gradient(
        90deg,
        rgba(4, 4, 4, 0.94) 0%,
        rgba(4, 4, 4, 0.82) 38%,
        rgba(4, 4, 4, 0.44) 68%,
        rgba(4, 4, 4, 0.24) 85%,
        rgba(4, 4, 4, 0.42) 100%
      ),
      /* Vertical vignette for header & bottom divider */
      linear-gradient(
        180deg,
        rgba(4, 4, 4, 0.5) 0%,
        transparent 25%,
        transparent 75%,
        rgba(4, 4, 4, 0.88) 100%
      );
  }

  /* Content Wrapper: Takes up almost 1 full screen (HAMPIR SATU LAYAR) */
  .hero-canvas-inner {
    position: relative;
    z-index: 2;
    padding-top: clamp(100px, 11vw, 136px);
    padding-bottom: clamp(36px, 4.5vw, 52px);
    display: flex;
    flex-direction: column;
    min-height: clamp(640px, 91vh, 860px);
    justify-content: space-between;
  }

  /* Top Area: Tag + Headline */
  .hero-top-area {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Top Eyebrow Tag */
  .hero-top-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.02em;
    margin-bottom: 20px;
    align-self: flex-start;
  }

  .tag-red-icon {
    width: 18px;
    height: 18px;
    background-color: var(--mp-red);
    color: #ffffff;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(198, 40, 40, 0.5);
  }

  /* Left Headline */
  .hero-headline {
    font-family: var(--mp-font-heading);
    font-size: clamp(2.35rem, 4.8vw, 4.2rem);
    font-weight: 400;
    color: #ffffff;
    line-height: 1.24;
    letter-spacing: -0.02em;
    margin: 0;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    max-width: 820px;
  }

  /* Lower Area: Description on Far Right (Turun ke bawah mendekati tombol CTA & garis) */
  .hero-lower-area {
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
    margin-bottom: 16px;
  }

  .hero-description {
    font-family: var(--mp-font-body);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    color: rgba(255, 255, 255, 0.86);
    line-height: 1.6;
    margin: 0;
    max-width: 440px;
    font-weight: 400;
  }

  @media (max-width: 768px) {
    .hero-lower-area {
      justify-content: flex-start;
      margin-top: 32px;
      margin-bottom: 20px;
    }
  }

  /* Bottom Row: Pillars on the Left, CTA buttons on the Right, SEJAJAR */
  .hero-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero-bottom-pillars {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(12px, 2vw, 32px);
  }

  .pillar-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgba(255, 255, 255, 0.85);
    font-size: clamp(0.8125rem, 0.95vw, 0.9375rem);
    font-weight: 500;
    transition: color 180ms ease;
    white-space: nowrap;
  }

  .pillar-item:hover {
    color: #ffffff;
  }

  .pillar-plus {
    color: var(--mp-red);
    font-weight: 700;
    font-size: 1.05rem;
  }

  /* CTA buttons group (Sejajar horizontal, pushed to far right) */
  .hero-cta-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    flex-wrap: nowrap;
  }

  /* Button Styles (Pill style) */
  :global(.stodio-btn) {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    border-radius: 9999px !important;
    padding: 12px 22px !important;
    font-family: var(--mp-font-body) !important;
    font-size: 0.9375rem !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    white-space: nowrap !important;
    transition: all 180ms ease !important;
    cursor: pointer !important;
    flex-shrink: 0;
  }

  /* Primary Red Pill Button */
  :global(.stodio-btn--primary) {
    background-color: var(--mp-red) !important;
    color: #ffffff !important;
    border: 1px solid var(--mp-red) !important;
    box-shadow: 0 8px 20px rgba(198, 40, 40, 0.35) !important;
  }

  :global(.stodio-btn--primary:hover) {
    background-color: var(--mp-red-dark) !important;
    border-color: var(--mp-red-dark) !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 12px 26px rgba(198, 40, 40, 0.5) !important;
    color: #ffffff !important;
  }

  /* Secondary White Pill Button */
  .stodio-btn--secondary {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  .stodio-btn--secondary:hover {
    background-color: #f3f4f6;
    color: var(--mp-red);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
  }

  /* Responsive for tablet and mobile */
  @media (max-width: 900px) {
    .hero-bottom-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .hero-cta-group {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .hero-bottom-row {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }

    .hero-cta-group {
      width: 100%;
      order: 1; /* CTAs first on mobile */
      gap: 8px;
    }

    .hero-bottom-pillars {
      order: 2;
      gap: 10px 16px;
    }

    :global(.stodio-btn) {
      padding: 11px 12px !important;
      font-size: 0.8125rem !important;
      gap: 6px !important;
      flex: 1 1 50% !important;
      min-width: 0 !important;
    }
  }

  @media (max-width: 380px) {
    :global(.stodio-btn) {
      padding: 10px 8px !important;
      font-size: 0.75rem !important;
    }
  }

  /* 4-Pill Stats Strip (Clean White Cards dengan Sentuhan Warna Merah Brand) */
  .stats-strip-container {
    position: relative;
    z-index: 10;
    margin-top: clamp(28px, 4.5vw, 48px);
  }

  .stats-pills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  @media (min-width: 576px) {
    .stats-pills-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (min-width: 992px) {
    .stats-pills-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }
  }

  .stat-pill-card {
    background: #ffffff;
    border: 1px solid rgba(198, 40, 40, 0.16);
    border-top: 3.5px solid var(--mp-red);
    border-radius: 18px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: 0 4px 18px rgba(198, 40, 40, 0.05), 0 2px 6px rgba(15, 23, 42, 0.03);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .stat-pill-card:hover {
    transform: translateY(-3px);
    border-color: var(--mp-red);
    box-shadow: 0 12px 28px rgba(198, 40, 40, 0.12);
  }

  .pill-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mp-font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--mp-red);
    background: var(--mp-red-soft);
    border: 1px solid rgba(198, 40, 40, 0.2);
    border-radius: 9999px;
    padding: 2.5px 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .pill-value {
    font-family: var(--mp-font-heading);
    font-size: clamp(1.125rem, 1.35vw, 1.3125rem);
    font-weight: 400;
    color: var(--mp-ink);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
</style>
