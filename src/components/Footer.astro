---
import WhatsAppButton from "./WhatsAppButton.astro";

const currentYear = new Date().getFullYear();
---

<footer class="mp-footer">
  <div class="mp-container footer-top">
    <!-- Brand Info Column -->
    <div class="footer-col footer-brand-col">
      <a href="/" class="brand-logo" aria-label="MagangPro - Beranda">
        <img
          src="/images/logo-magangpro.webp"
          alt="MagangPro"
          width="160"
          height="53"
          class="footer-logo-img"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="brand-desc">
        Pusat informasi dan program magang terstruktur untuk siswa SMK/PKL dan
        internship mahasiswa, serta pelatihan digital marketing komprehensif
        bagi UMKM, instansi, dan perusahaan.
      </p>

      <div class="verified-info">
        <div class="info-row">
          <svg
            class="info-icon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Mojolangu, Kota Malang, Jawa Timur 65142</span>
        </div>
        <div class="info-row">
          <svg
            class="info-icon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path>
          </svg>
          <a
            href="https://wa.me/62895639068080"
            class="hover-red"
            target="_blank"
            rel="noopener noreferrer">+62 895-6390-68080</a
          >
        </div>
      </div>
    </div>

    <!-- Navigation Column 1: Program Magang -->
    <div class="footer-col">
      <h3 class="footer-heading">Program Magang</h3>
      <ul class="footer-links">
        <li><a href="/program-magang/magang-smk-pkl">Magang SMK & PKL</a></li>
        <li>
          <a href="/program-magang/internship-mahasiswa"
            >Internship Mahasiswa</a>
        </li>
        <li><a href="/program-magang/posisi">Posisi & Bidang Magang</a></li>
        <li>
          <a href="/program-magang/kompetensi">Kompetensi yang Dipelajari</a>
        </li>
        <li>
          <a href="/program-magang/alur-pendaftaran">Alur Pendaftaran</a>
        </li>
      </ul>
    </div>

    <!-- Navigation Column 2: Pelatihan & Jasa -->
    <div class="footer-col">
      <h3 class="footer-heading">Pelatihan & Jasa</h3>
      <ul class="footer-links">
        <li>
          <a href="/pelatihan-digital-marketing/umkm">Pelatihan untuk UMKM</a>
        </li>
        <li>
          <a href="/pelatihan-digital-marketing/instansi-perusahaan"
            >Pelatihan Instansi & Korporat</a>
        </li>
        <li><a href="/jasa">Layanan Optimasi SEO</a></li>
        <li><a href="/jasa">Pengembangan Website SSG</a></li>
        <li><a href="/portofolio">Portofolio & Galeri</a></li>
      </ul>
    </div>

    <!-- Navigation Column 3: Konsultasi Cepat -->
    <div class="footer-col footer-cta-col">
      <h3 class="footer-heading">Konsultasi Cepat</h3>
      <p class="cta-col-desc">
        Tanyakan ketersediaan kuota magang PKL atau jadwal pelatihan digital marketing.
      </p>

      <!-- Status Indicator Pill -->
      <div class="footer-status-pill">
        <span class="status-dot-pulse" aria-hidden="true"></span>
        <span class="status-text">Admin Online (08.00–17.00)</span>
      </div>

      <!-- Compact Proportional WhatsApp Button -->
      <div class="footer-wa-action">
        <WhatsAppButton
          label="Chat via WhatsApp"
          message="Halo MagangPro, saya ingin bertanya tentang informasi program."
          variant="whatsapp"
          size="sm"
          class="footer-wa-btn"
        />
      </div>
    </div>
  </div>

  <!-- Footer Bottom (Legal & Copyright) -->
  <div class="footer-bottom">
    <div class="mp-container bottom-inner">
      <p class="copyright">
        &copy; {currentYear}
        <strong>MagangPro</strong>. Hak cipta dilindungi undang-undang.
      </p>
      <div class="legal-links">
        <a href="/tentang-kami">Tentang Kami</a>
        <a href="/galeri">Galeri</a>
        <a href="/blog">Blog Edukasi</a>
        <a href="/kebijakan-privasi">Kebijakan Privasi</a>
        <a href="/syarat-ketentuan">Syarat & Ketentuan</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .mp-footer {
    background-color: var(--mp-surface);
    border-top: 1px solid var(--mp-border);
    margin-top: auto;
  }

  .footer-top {
    padding-block: clamp(48px, 6vw, 80px);
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-top {
      grid-template-columns: 2.2fr 1.2fr 1.2fr 1.4fr;
      gap: 48px;
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    margin-bottom: 16px;
    line-height: 1;
  }

  .footer-logo-img {
    height: 48px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
    display: block;
    transition: opacity 180ms ease;
  }

  .brand-logo:hover .footer-logo-img {
    opacity: 0.9;
  }

  .brand-desc {
    font-size: 0.875rem;
    color: var(--mp-muted);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .verified-info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.875rem;
    color: var(--mp-text);
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .info-icon {
    color: var(--mp-red);
    flex-shrink: 0;
  }

  .hover-red:hover {
    color: var(--mp-red);
  }

  .footer-heading {
    font-family: var(--mp-font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--mp-ink);
    margin-bottom: 18px;
    position: relative;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--mp-muted);
    transition: all 160ms ease;
  }

  .footer-links a:hover {
    color: var(--mp-red);
    padding-left: 4px;
  }

  .cta-col-desc {
    font-size: 0.875rem;
    color: var(--mp-muted);
    margin-bottom: 12px;
    line-height: 1.6;
  }

  .footer-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(37, 211, 102, 0.1);
    border: 1px solid rgba(37, 211, 102, 0.28);
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #15803d;
    margin-bottom: 14px;
    width: fit-content;
  }

  .status-dot-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: status-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes status-ping {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .footer-wa-action {
    display: flex;
    align-items: flex-start;
  }

  :global(.footer-wa-btn) {
    width: auto !important;
    display: inline-flex !important;
    padding: 9px 18px !important;
    font-size: 0.875rem !important;
    font-weight: 600 !important;
    border-radius: 9999px !important;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.22) !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease !important;
  }

  :global(.footer-wa-btn:hover) {
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 18px rgba(37, 211, 102, 0.35) !important;
  }

  /* Bottom Bar */
  .footer-bottom {
    background-color: #f3f4f6;
    border-top: 1px solid var(--mp-border);
    padding-block: 20px;
  }

  .bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .copyright {
    font-size: 0.8125rem;
    color: var(--mp-muted);
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .legal-links a {
    font-size: 0.8125rem;
    color: var(--mp-muted);
  }

  .legal-links a:hover {
    color: var(--mp-red);
  }
</style>
