---
import { mitraList } from '../data/mitra';
import WhatsAppButton from './WhatsAppButton.astro';
---

<section class="mp-section mp-section--surface" id="mitra-kolaborasi">
  <div class="mp-container">
    <div class="section-header text-center">
      <span class="eyebrow">Jaringan Kemitraan</span>
      <h2 class="heading-lg">Dipercaya Puluhan Institusi Pendidikan & Industri</h2>
      <p>
        PixxelPro aktif berkolaborasi dengan berbagai SMK vokasi, politeknik, universitas terkemuka, serta media industri di Jawa Timur dalam program magang, PKL, dan pelatihan digital.
      </p>
    </div>

    <!-- Responsive Grid of Partner Cards -->
    <div class="mitra-grid">
      {mitraList.map((item) => (
        <div class="mitra-card">
          <div class="mitra-logo-box">
            <img
              src={item.logo}
              alt={`Logo ${item.name}`}
              width="100"
              height="80"
              loading="lazy"
              decoding="async"
              class="mitra-logo-img"
            />
          </div>
          <div class="mitra-details">
            <span class="mitra-badge">{item.categoryLabel}</span>
            <h3 class="mitra-name">{item.name}</h3>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Collaboration CTA Box -->
    <div class="mitra-cta-box">
      <div class="mitra-cta-content">
        <div class="cta-badge">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span>Terbuka untuk MoA & Kerja Sama Kemitraan Sekolah / Kampus Baru</span>
        </div>
        <h3 class="cta-title">Ingin Menjalin Kemitraan Edukasi & Industri?</h3>
        <p class="cta-desc">
          Kami siap berkolaborasi dalam penyaluran magang PKL SMK, internship MBKM perguruan tinggi, kuliah tamu, maupun pelatihan kapasitas digital terarah.
        </p>
      </div>

      <div class="mitra-cta-actions">
        <a href="/mitra" class="btn-mitra-page">
          <span>Lihat Halaman Khusus Mitra</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <WhatsAppButton
          label="Konsultasi Kerja Sama"
          message="Halo PixxelPro, kami dari instansi/sekolah/kampus ingin berdiskusi mengenai kerja sama kemitraan magang & pelatihan."
          variant="whatsapp"
          size="md"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .mitra-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    max-width: 1200px;
    margin-inline: auto;
  }

  @media (max-width: 1024px) {
    .mitra-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 680px) {
    .mitra-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  .mitra-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 22px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .mitra-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
    border-color: rgba(198, 40, 40, 0.35);
  }

  .mitra-logo-box {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    padding: 6px;
  }

  .mitra-logo-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.06));
    transition: transform 220ms ease;
  }

  .mitra-card:hover .mitra-logo-img {
    transform: scale(1.08);
  }

  .mitra-details {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .mitra-badge {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--mp-red);
    background: rgba(198, 40, 40, 0.08);
    padding: 3px 10px;
    border-radius: 9999px;
    margin-bottom: 8px;
  }

  .mitra-name {
    font-family: var(--mp-font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: #1e293b;
    line-height: 1.35;
    margin: 0;
  }

  /* Mitra CTA Box */
  .mitra-cta-box {
    margin-top: clamp(40px, 5vw, 60px);
    background: linear-gradient(135deg, #0d1117 0%, #161b22 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: clamp(28px, 4vw, 42px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 900px) {
    .mitra-cta-box {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
  }

  .mitra-cta-content {
    max-width: 620px;
  }

  .cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    margin-bottom: 12px;
  }

  .cta-badge svg {
    color: #ef4444;
  }

  .cta-title {
    font-family: var(--mp-font-heading);
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    margin: 0 0 10px;
  }

  .cta-desc {
    font-size: 0.925rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  .mitra-cta-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .mitra-cta-actions {
      justify-content: center;
    }
  }

  .btn-mitra-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 22px;
    background: #ffffff;
    color: #0f172a;
    font-family: var(--mp-font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 180ms ease;
    box-shadow: 0 4px 14px rgba(255, 255, 255, 0.12);
  }

  .btn-mitra-page:hover {
    background: #f1f5f9;
    color: var(--mp-red);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 255, 255, 0.2);
  }

  .btn-mitra-page svg {
    transition: transform 180ms ease;
  }

  .btn-mitra-page:hover svg {
    transform: translateX(4px);
  }
</style>
