---
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  desc?: string;
  waLabel?: string;
  waMessage?: string;
  primaryBtn?: {
    label: string;
    href: string;
  };
  secondaryBtn?: {
    label: string;
    href: string;
  };
}

const {
  eyebrow = 'Siap Memulai Langkah Baru?',
  title = 'Tingkatkan Kompetensi Nyata Bersama MagangPro',
  desc = 'Jangan ragu untuk berdiskusi mengenai ketersediaan kuota magang, persyaratan sekolah/kampus, atau silabus pelatihan digital marketing untuk tim Anda.',
  waLabel = 'Chat WhatsApp Admin',
  waMessage = 'Halo MagangPro, saya ingin bertanya lebih lanjut mengenai program magang yang tersedia.',
  primaryBtn,
  secondaryBtn,
} = Astro.props;
---

<section class="mp-section mp-cta-banner">
  <div class="mp-container">
    <div class="banner-inner">
      <span class="eyebrow eyebrow--light">{eyebrow}</span>
      <h2 class="banner-title">
        {title}
      </h2>
      <p class="banner-desc">
        {desc}
      </p>
      <div class="banner-actions">
        {primaryBtn ? (
          <div class="banner-custom-actions">
            <a href={primaryBtn.href} class="cta-custom-btn cta-btn-primary">
              <span>{primaryBtn.label}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            {secondaryBtn && (
              <a
                href={secondaryBtn.href}
                class="cta-custom-btn cta-btn-secondary"
                target={secondaryBtn.href.startsWith('http') ? '_blank' : undefined}
                rel={secondaryBtn.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <span>{secondaryBtn.label}</span>
              </a>
            )}
          </div>
        ) : (
          <WhatsAppButton
            label={waLabel}
            message={waMessage}
            variant="whatsapp"
            size="lg"
          />
        )}
      </div>
      <div class="banner-location">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>Mojolangu, Kota Malang, Jawa Timur 65142</span>
      </div>
    </div>
  </div>
</section>

<style>
  .mp-cta-banner {
    background-color: var(--mp-ink);
    color: var(--mp-white);
    text-align: center;
    padding-block: clamp(60px, 8vw, 90px);
  }

  .banner-inner {
    max-width: 780px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow--light {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 9999px;
    margin-bottom: 14px;
    display: inline-block;
  }

  .banner-title {
    color: #ffffff;
    font-size: clamp(1.85rem, 3.5vw, 2.75rem);
    margin-bottom: 16px;
    line-height: 1.25;
  }

  .banner-desc {
    color: #d1d5db;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .banner-actions {
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .banner-actions :global(.mp-button) {
    margin-inline: auto;
  }

  .banner-custom-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-custom-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 1.75rem;
    border-radius: 9999px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .cta-btn-primary {
    background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(239, 68, 68, 0.35);
  }

  .cta-btn-primary:hover {
    background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(239, 68, 68, 0.45);
  }

  .cta-btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
  }

  .cta-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-2px);
  }

  .banner-location {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: #9ca3af;
  }
</style>
