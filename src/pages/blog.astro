---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { blogPosts } from '../data/blog';

const pageTitle = "Blog & Wawasan Digital | MagangPro Malang";
const pageDescription = "Kumpulan artikel edukatif, panduan magang SMK & mahasiswa, tips strategi digital marketing UMKM, serta wawasan teknologi terkini dari praktisi MagangPro Malang.";

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Blog' },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- 1. Unified Page Banner -->
  <PageBanner
    pill="Artikel & Wawasan Edukasi"
    title="Blog & Wawasan"
    description="Pusat informasi, panduan magang SMK & mahasiswa, strategi digital marketing UMKM, serta artikel perkembangan industri teknologi terkini di Kota Malang."
    breadcrumbs={breadcrumbs}
  />

  <!-- 2. Section Blog List -->
  <section class="mp-section" id="blog-section">
    <div class="mp-container">
      <!-- Centered Search Box -->
      <div class="blog-search-centered">
        <div class="search-box-wrap">
          <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="blog-search-input"
            class="search-input"
            placeholder="Cari artikel atau topik..."
            aria-label="Cari artikel"
          />
        </div>
      </div>

      <!-- 3-Cards Per Row Grid -->
      <div class="blog-grid-3col" id="blog-posts-grid">
        {blogPosts.map((post) => (
          <article
            class="blog-card"
            data-category={post.categorySlug}
            data-title={post.title.toLowerCase()}
            data-excerpt={post.excerpt.toLowerCase()}
          >
            <!-- Card Image -->
            <a href={`/blog/${post.slug}`} class="card-thumb-link" tabindex="-1" aria-hidden="true">
              <div class="thumb-container">
                <img
                  src={post.image}
                  alt={post.title}
                  width="400"
                  height="240"
                  loading="lazy"
                  decoding="async"
                  class="card-img"
                />
                <span class="card-category-badge">{post.category}</span>
              </div>
            </a>

            <!-- Card Content -->
            <div class="card-body">
              <!-- Meta Info: Date & Reading Time -->
              <div class="card-meta">
                <span class="meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <span>{post.date}</span>
                </span>
                <span class="meta-divider">•</span>
                <span class="meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span>{post.readTime}</span>
                </span>
              </div>

              <!-- Title -->
              <h3 class="card-title">
                <a href={`/blog/${post.slug}`} class="card-title-link">
                  {post.title}
                </a>
              </h3>

              <!-- Excerpt -->
              <p class="card-excerpt">
                {post.excerpt}
              </p>

              <!-- Footer: Author & Read More -->
              <div class="card-footer">
                <div class="author-info">
                  <div class="author-avatar" aria-hidden="true">
                    <span>{post.author.name.charAt(0)}</span>
                  </div>
                  <div class="author-text">
                    <span class="author-name">{post.author.name}</span>
                    <span class="author-role">{post.author.role}</span>
                  </div>
                </div>

                <a href={`/blog/${post.slug}`} class="read-more-btn" aria-label={`Baca artikel: ${post.title}`}>
                  <span>Baca</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty State (When no results found) -->
      <div class="empty-state" id="empty-state" style="display: none;">
        <div class="empty-icon-box">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
        <h4 class="empty-title">Tidak Ada Artikel yang Ditemukan</h4>
        <p class="empty-desc">Coba gunakan kata kunci pencarian yang lain atau pilih kategori di atas.</p>
        <button type="button" class="empty-reset-btn" id="reset-filter-btn">
          Tampilkan Semua Artikel
        </button>
      </div>
    </div>
  </section>

  <!-- 3. Unified Closing CTA Banner -->
  <CtaBanner
    eyebrow="Ingin Praktik & Pengalaman Nyata?"
    title="Wujudkan Karier Digital Anda Bersama MagangPro Malang"
    desc="Pelajari keahlian industri secara langsung lewat program magang terstruktur dan pelatihan intensif berorientasi hasil riil."
    primaryBtn={{
      label: "Daftar Program Magang",
      href: "/program-magang"
    }}
    secondaryBtn={{
      label: "Konsultasi Pelatihan UMKM",
      href: "/pelatihan-digital-marketing/umkm"
    }}
  />
</BaseLayout>

<script>
  // Search Input Handler
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>('.blog-card');
    const emptyState = document.getElementById('empty-state');
    const resetBtn = document.getElementById('reset-filter-btn');

    let searchQuery = '';

    function filterCards() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardTitle = card.getAttribute('data-title') || '';
        const cardExcerpt = card.getAttribute('data-excerpt') || '';

        const matchesSearch = !searchQuery || cardTitle.includes(searchQuery) || cardExcerpt.includes(searchQuery);

        if (matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterCards();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        searchQuery = '';
        filterCards();
      });
    }
  });
</script>

<style>
  /* ----------------------------------------------------
     BLOG SEARCH (CENTERED)
     ---------------------------------------------------- */
  .blog-search-centered {
    display: flex;
    justify-content: center;
    margin-bottom: 2.75rem;
  }

  .search-box-wrap {
    position: relative;
    width: 100%;
    max-width: 540px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--mp-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.6rem 1rem 0.6rem 2.5rem;
    font-family: inherit;
    font-size: 0.875rem;
    color: var(--mp-ink);
    background-color: var(--mp-surface);
    border: 1px solid var(--mp-border);
    border-radius: 999px;
    outline: none;
    transition: all 0.2s ease;
  }

  .search-input:focus {
    background-color: var(--mp-white);
    border-color: var(--mp-red);
    box-shadow: 0 0 0 3px rgba(198, 40, 40, 0.12);
  }

  /* ----------------------------------------------------
     3 CARDS PER ROW GRID
     ---------------------------------------------------- */
  .blog-grid-3col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  /* ----------------------------------------------------
     SIMPEL & BERSIH BLOG CARD DESIGN
     ---------------------------------------------------- */
  .blog-card {
    display: flex;
    flex-direction: column;
    background-color: var(--mp-white);
    border-radius: var(--mp-radius-md);
    border: 1px solid var(--mp-border);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 32px rgba(17, 24, 39, 0.08);
    border-color: #cbd5e1;
  }

  /* Thumbnail Area */
  .card-thumb-link {
    display: block;
    text-decoration: none;
    overflow: hidden;
  }

  .thumb-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9.6;
    background-color: #0f172a;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-category-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--mp-white);
    background: rgba(17, 24, 39, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    letter-spacing: 0.3px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  /* Card Body */
  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }

  /* Meta Info */
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--mp-muted);
    margin-bottom: 0.75rem;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-divider {
    color: #cbd5e1;
  }

  /* Title */
  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.45;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-title-link {
    color: var(--mp-ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title-link:hover,
  .blog-card:hover .card-title-link {
    color: var(--mp-red);
  }

  /* Excerpt */
  .card-excerpt {
    font-size: 0.875rem;
    color: var(--mp-text);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Footer */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid #f1f5f9;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .author-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ef4444, #b91c1c);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .author-text {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--mp-ink);
    line-height: 1.2;
  }

  .author-role {
    font-size: 0.7rem;
    color: var(--mp-muted);
  }

  .read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--mp-red);
    text-decoration: none;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .read-more-btn:hover {
    color: var(--mp-red-dark);
    transform: translateX(3px);
  }

  /* ----------------------------------------------------
     EMPTY STATE
     ---------------------------------------------------- */
  .empty-state {
    text-align: center;
    padding: 4rem 1.5rem;
    background-color: var(--mp-surface);
    border-radius: var(--mp-radius-md);
    border: 1px dashed var(--mp-border);
    margin-top: 1rem;
  }

  .empty-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: #f1f5f9;
    color: var(--mp-muted);
    margin-bottom: 1rem;
  }

  .empty-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--mp-ink);
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    font-size: 0.9rem;
    color: var(--mp-muted);
    max-width: 420px;
    margin: 0 auto 1.5rem;
  }

  .empty-reset-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    background-color: var(--mp-ink);
    color: var(--mp-white);
    font-size: 0.85rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .empty-reset-btn:hover {
    background-color: var(--mp-red);
  }

  /* ----------------------------------------------------
     RESPONSIVE BREAKPOINTS
     ---------------------------------------------------- */
  @media (max-width: 1024px) {
    .blog-grid-3col {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .blog-controls-bar {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .category-filters {
      overflow-x: auto;
      padding-bottom: 0.5rem;
      -webkit-overflow-scrolling: touch;
      flex-wrap: nowrap;
    }

    .search-box-wrap {
      width: 100%;
      min-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .blog-grid-3col {
      grid-template-columns: 1fr;
    }

    .card-body {
      padding: 1.25rem;
    }
  }
</style>
