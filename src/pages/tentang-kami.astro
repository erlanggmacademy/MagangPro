---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const pageTitle = "Tentang Kami | Profil & Visi Misi MagangPro Malang";
const pageDescription = "Kenali profil MagangPro, pusat program magang SMK, internship mahasiswa, dan pelatihan digital marketing berbasis proyek riil di Mojolangu, Lowokwaru, Kota Malang.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- 1. Page Banner with Torn Paper Bottom (No Background Image, MagangPro Theme) -->
  <section class="mp-page-banner">
    <div class="banner-ambient-glow" aria-hidden="true"></div>
    <div class="banner-grid-pattern" aria-hidden="true"></div>

    <div class="mp-container banner-content">
      <!-- Pill Eyebrow (Matching Reference Style) -->
      <div class="banner-pill">
        <span>Tentang MagangPro</span>
      </div>

      <!-- Main Headline (Simple & Impactful) -->
      <h1 class="page-banner-title">
        Tentang Kami
      </h1>

      <!-- Simple Description -->
      <p class="page-banner-desc">
        Pusat informasi dan inkubator program magang SMK, internship mahasiswa, serta pelatihan digital marketing berbasis proyek riil di Kota Malang.
      </p>

      <!-- Breadcrumb (Placed Below Description) -->
      <nav class="banner-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Beranda</a></li>
          <li class="separator" aria-hidden="true">/</li>
          <li class="active" aria-current="page">Tentang Kami</li>
        </ol>
      </nav>
    </div>

    <!-- Dual-Layered Natural Organic Torn Paper Bottom Divider -->
    <div class="torn-paper-divider" aria-hidden="true">
      <svg
        class="torn-paper-svg"
        viewBox="0 0 1440 100"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Back Shadow / Fibrous Underlay for 3D Torn Paper Depth -->
        <path
          d="M0,100 L0,41 L9,40 L21,45 L32,41 L44,46 L53,49 L65,46 L81,48 L96,50 L106,51 L114,41 L122,44 L141,47 L160,44 L176,42 L186,42 L202,35 L219,35 L235,32 L249,32 L264,33 L274,39 L286,39 L304,34 L322,35 L331,40 L350,43 L361,46 L377,40 L397,42 L411,44 L419,44 L433,39 L442,42 L461,38 L471,36 L488,41 L505,35 L522,42 L531,34 L544,40 L562,35 L582,42 L592,43 L613,47 L631,44 L639,46 L656,54 L675,57 L696,55 L705,55 L720,53 L741,46 L756,51 L776,49 L796,45 L804,42 L817,42 L834,34 L847,39 L856,36 L870,34 L889,36 L906,38 L918,35 L932,38 L941,37 L959,33 L972,33 L981,36 L992,35 L1007,30 L1025,32 L1036,28 L1056,27 L1072,28 L1086,17 L1105,19 L1119,18 L1132,14 L1141,13 L1157,12 L1165,9 L1186,10 L1206,13 L1220,11 L1234,16 L1255,13 L1265,14 L1273,16 L1294,19 L1313,25 L1327,21 L1340,22 L1354,31 L1370,20 L1378,29 L1395,26 L1416,22 L1440,22 L1440,100 Z"
          fill="rgba(255, 255, 255, 0.45)"
        />
        <!-- Front Crisp Torn Paper Edge (Seamless into white section below) -->
        <path
          d="M0,100 L0,61 L16,60 L36,59 L54,61 L73,60 L86,65 L96,61 L106,62 L122,63 L134,58 L146,62 L154,57 L163,58 L183,54 L201,52 L212,49 L231,47 L242,52 L261,47 L273,47 L287,48 L302,53 L318,53 L330,54 L340,57 L360,58 L368,57 L384,59 L403,56 L415,54 L423,55 L444,51 L460,58 L474,56 L494,50 L509,54 L519,50 L532,53 L541,50 L561,49 L576,52 L587,53 L604,57 L621,65 L632,59 L641,64 L662,63 L682,67 L700,67 L713,67 L732,60 L745,66 L762,62 L778,64 L793,61 L808,55 L819,51 L833,53 L846,54 L863,56 L881,52 L896,48 L911,48 L927,51 L945,55 L961,46 L976,47 L993,48 L1011,49 L1031,42 L1040,47 L1061,41 L1082,42 L1090,33 L1101,37 L1122,33 L1136,27 L1154,25 L1172,24 L1191,27 L1207,27 L1225,23 L1234,30 L1244,26 L1260,32 L1281,35 L1291,31 L1305,34 L1322,40 L1338,42 L1349,38 L1368,40 L1386,41 L1403,37 L1411,39 L1431,33 L1440,36 L1440,100 Z"
          fill="#ffffff"
        />
      </svg>
    </div>
  </section>

  <!-- 2. Cerita & Latar Belakang Kami -->
  <section class="mp-section mp-about-story" id="cerita-kami">
    <div class="mp-container">
      <div class="about-grid">
        <!-- Kolom Teks Cerita -->
        <div class="about-text-col">
          <span class="eyebrow">Latar Belakang</span>
          <h2 class="heading-lg">Mengapa MagangPro Didirikan?</h2>
          <p class="lead-text">
            Banyak siswa SMK dan mahasiswa menjalani masa magang tanpa pengalaman teknis yang memadai, kerap hanya ditugaskan merapikan dokumen administratif atau tugas di luar bidang keahliannya.
          </p>
          <p>
            Di sisi lain, dunia industri teknologi dan ribuan pelaku UMKM di Malang Raya sangat membutuhkan talenta muda yang sudah menguasai alur kerja riil: pengembangan website modern, optimasi kata kunci Google (SEO), perancangan identitas visual, serta pengelolaan kampanye digital yang mendatangkan konversi penjualan.
          </p>
          <p>
            <strong>MagangPro hadir untuk menutup jurang pemisah tersebut.</strong> Kami menyusun silabus praktik terstruktur berbasis tugas riil, menyediakan fasilitas lab onsite yang kondusif di kawasan pendidikan Mojolangu Kota Malang, dan mendampingi setiap peserta dengan mentor praktisi yang berpengalaman.
          </p>

          <div class="quote-highlight-box">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="var(--mp-red)" class="quote-icon" aria-hidden="true">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
            <p>
              "Misi utama kami bukan sekadar memenuhi syarat presensi jam magang, melainkan memastikan saat lulus nanti, peserta memiliki portofolio proyek karya nyata yang dibanggakan dan siap dipakai melamar kerja."
            </p>
          </div>
        </div>

        <!-- Kolom Kartu Keunggulan / Pilar -->
        <div class="about-cards-col">
          <div class="feature-card">
            <div class="feature-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <div class="feature-content">
              <h3>Kurikulum Sesuai Jurusan</h3>
              <p>Materi PKL/Internship disesuaikan dengan jurusan peserta (RPL, TKJ, Multimedia, DKV, Bisnis Digital, Manajemen, Informatika).</p>
            </div>
          </div>

          <div class="feature-card">
            <div class="feature-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <div class="feature-content">
              <h3>Mentor Praktisi Onsite</h3>
              <p>Diskusi teknis harian, evaluasi sprint mingguan, dan bimbingan 1-on-1 saat peserta mengalami kendala teknis.</p>
            </div>
          </div>

          <div class="feature-card">
            <div class="feature-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
            <div class="feature-content">
              <h3>Portofolio Proyek Nyata</h3>
              <p>Peserta mengerjakan website klien riil, studi kasus Google Profil Bisnis UMKM, atau aset desain promosi resmi.</p>
            </div>
          </div>

          <div class="feature-card">
            <div class="feature-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <div class="feature-content">
              <h3>Dukungan Laporan & Sertifikat</h3>
              <p>Bimbingan penyusunan bab laporan PKL, penilaian objektif untuk guru/dosen, serta sertifikat resmi berpredikat.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Visi & Misi Kami -->
  <section class="mp-section mp-section--surface" id="visi-misi">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Arah & Komitmen</span>
        <h2 class="heading-lg">Visi & Misi MagangPro</h2>
        <p>Landasan nilai yang memandu setiap kurikulum, sesi mentoring, dan kolaborasi kami bersama sekolah serta industri.</p>
      </div>

      <div class="vision-mission-wrapper">
        <!-- Visi Box -->
        <div class="vision-card">
          <div class="vision-tag">VISI KAMI</div>
          <p class="vision-statement">
            "Menjadi inkubator talenta digital dan mitra edukasi terpercaya di Jawa Timur yang mencetak lulusan SMK dan perguruan tinggi yang kompeten, adaptif, serta berintegritas industri tinggi."
          </p>
        </div>

        <!-- Misi 3 Kolom -->
        <div class="mission-grid">
          <div class="mission-item">
            <div class="mission-num">01</div>
            <h3>Pendidikan Berbasis Proyek</h3>
            <p>Menyelenggarakan pembelajaran aplikatif langsung pada studi kasus nyata, bukan hafalan teori atau sekadar tugas simulasi.</p>
          </div>

          <div class="mission-item">
            <div class="mission-num">02</div>
            <h3>Standarisasi Kompetensi</h3>
            <p>Menyelaraskan kurikulum magang dengan standar industri teknologi terdepan (Stack modern, SEO Google, Copywriting, Design System).</p>
          </div>

          <div class="mission-item">
            <div class="mission-num">03</div>
            <h3>Pemberdayaan Bisnis Lokal</h3>
            <p>Menghubungkan karya kreatif peserta magang dengan kebutuhan digitalisasi UMKM dan instansi di Malang Raya agar saling berdampak positif.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Nilai-Nilai Inti (Core Values) -->
  <section class="mp-section" id="nilai-inti">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Budaya Kerja</span>
        <h2 class="heading-lg">4 Pilar Nilai MagangPro</h2>
        <p>Karakter yang kami tanamkan kepada setiap peserta magang selama berproses bersama kami.</p>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-badge">01</div>
          <h3>Integritas & Disiplin</h3>
          <p>Membiasakan jam kerja profesional, ketepatan waktu pengumpulan sprint tugas, serta komunikasi tim yang santun dan terbuka.</p>
        </div>

        <div class="value-card">
          <div class="value-badge">02</div>
          <h3>Karya Berstandar Industri</h3>
          <p>Membiasakan kualitas hasil kerja terbaik, mulai dari kode yang rapi, desain yang berorientasi pengguna, hingga riset kata kunci akurat.</p>
        </div>

        <div class="value-card">
          <div class="value-badge">03</div>
          <h3>Kolaborasi & Keterbukaan</h3>
          <p>Mendorong sesi diskusi kelompok, keterbukaan menerima kritik saat code review, dan saling membantu saat rekan tim mengalami kesulitan.</p>
        </div>

        <div class="value-card">
          <div class="value-badge">04</div>
          <h3>Dampak Nyata (Impactful)</h3>
          <p>Setiap proyek yang dikerjakan harus memberikan nilai guna nyata bagi bisnis klien mitra dan menjadi bukti keahlian yang dapat dipertanggungjawabkan.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Lokasi & Fasilitas Onsite -->
  <section class="mp-section mp-section--surface" id="fasilitas-lokasi">
    <div class="mp-container">
      <div class="location-wrapper">
        <div class="location-content">
          <span class="eyebrow">Lingkungan Belajar Onsite</span>
          <h2 class="heading-lg">Fasilitas Lab di Kawasan Pendidikan Kota Malang</h2>
          <p>
            Berada di lokasi strategis <strong>Mojolangu, Kecamatan Lowokwaru, Kota Malang</strong>, kawasan sentra pendidikan yang dekat dengan universitas dan SMK ternama di Malang.
          </p>
          <ul class="facility-list">
            <li>
              <div class="fac-check">✓</div>
              <div>
                <strong>Koneksi Internet Cepat & Stabil:</strong> Menunjang deployment website, riset data marketing, dan upload aset multimedia.
              </div>
            </li>
            <li>
              <div class="fac-check">✓</div>
              <div>
                <strong>Lab Ber-AC & Meja Kerja Kolaboratif:</strong> Suasana kerja santai namun fokus menyerupai lingkungan startup teknologi.
              </div>
            </li>
            <li>
              <div class="fac-check">✓</div>
              <div>
                <strong>Layar Presentasi & Code Review:</strong> Sesi review harian untuk membedah tantangan teknis bersama lead engineer.
              </div>
            </li>
            <li>
              <div class="fac-check">✓</div>
              <div>
                <strong>Musholla, Area Istirahat, & Tempat Parkir Aman:</strong> Mendukung kenyamanan peserta magang selama beraktivitas sehari-hari.
              </div>
            </li>
          </ul>
        </div>

        <div class="location-card-box">
          <div class="map-info-card">
            <div class="map-badge">LOKASI KAMI</div>
            <h3 class="map-title">MagangPro Kota Malang</h3>
            <p class="map-address">
              Mojolangu, Kec. Lowokwaru, Kota Malang, Jawa Timur 65142
            </p>
            <div class="map-schedule">
              <span class="schedule-dot"></span>
              <span>Jam Operasional: Senin – Sabtu (08.00 – 17.00 WIB)</span>
            </div>
            <div class="map-contact-action">
              <a
                href="https://wa.me/62895639068080?text=Halo%20MagangPro%2C%20saya%20ingin%20berkunjung%20ke%20lab%20MagangPro%20di%20Mojolangu."
                target="_blank"
                rel="noopener noreferrer"
                class="mp-button mp-button--primary btn-sm"
              >
                <span>Petunjuk Arah via WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Call to Action Kerja Sama Sekolah & Pendaftaran (Identical to Homepage for consistency) -->
  <section class="mp-section mp-cta-banner">
    <div class="mp-container">
      <div class="banner-inner">
        <span class="eyebrow eyebrow--light">Siap Memulai Langkah Baru?</span>
        <h2 class="banner-title">
          Tingkatkan Kompetensi Nyata Bersama MagangPro
        </h2>
        <p class="banner-desc">
          Jangan ragu untuk berdiskusi mengenai ketersediaan kuota magang, persyaratan sekolah/kampus, atau silabus pelatihan digital marketing untuk tim Anda.
        </p>
        <div class="banner-actions">
          <WhatsAppButton
            label="Chat WhatsApp Admin"
            message="Halo MagangPro, saya ingin bertanya lebih lanjut mengenai program yang tersedia."
            variant="whatsapp"
            size="lg"
          />
        </div>
        <div class="banner-location">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Mojolangu, Kota Malang, Jawa Timur 65142</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Page Banner: Cinematic Monochrome Black with Soft White Mist (Hitam Burem Putih kaya Hero) */
  .mp-page-banner {
    position: relative;
    background-color: #060606;
    color: #ffffff;
    padding-top: clamp(65px, 8vw, 100px);
    padding-bottom: clamp(100px, 12vw, 140px); /* extra padding for torn paper */
    overflow: hidden;
  }

  /* Soft White Mist / Ambient Blur Overlay (No red, no blue - Pure Hero Monochrome) */
  .banner-ambient-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      /* Soft white translucent mist wash di tengah */
      radial-gradient(
        circle at 50% 36%,
        rgba(255, 255, 255, 0.16) 0%,
        rgba(255, 255, 255, 0.04) 50%,
        transparent 75%
      ),
      /* Smooth dark vignette */
      linear-gradient(
        180deg,
        rgba(6, 6, 6, 0.6) 0%,
        rgba(6, 6, 6, 0.96) 100%
      );
    z-index: 1;
  }

  .banner-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 1;
  }

  .banner-content {
    position: relative;
    z-index: 2;
    max-width: 920px;
    margin-inline: auto;
    text-align: center;
  }

  /* Breadcrumb (Plain text, no box/container) */
  .banner-breadcrumb {
    margin-top: 20px;
    margin-bottom: 0;
  }

  .banner-breadcrumb ol {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
    background: none;
    border: none;
    padding: 0;
  }

  .banner-breadcrumb a {
    color: rgba(255, 255, 255, 0.68);
    transition: color 160ms ease;
  }

  .banner-breadcrumb a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .banner-breadcrumb .separator {
    color: rgba(255, 255, 255, 0.35);
  }

  .banner-breadcrumb .active {
    color: #ffffff;
    font-weight: 600;
  }

  /* Pill Eyebrow (matching reference pill) */
  .banner-pill {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 7px 22px;
    border-radius: 9999px;
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 20px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* Title & Desc */
  .page-banner-title {
    font-family: var(--mp-font-heading);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  .page-banner-desc {
    font-family: var(--mp-font-body);
    font-size: clamp(0.95rem, 1.25vw, 1.1rem);
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.7;
    max-width: 700px;
    margin-inline: auto;
    margin-bottom: 10px;
  }

  /* Torn Paper Bottom Edge Divider */
  .torn-paper-divider {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
    pointer-events: none;
  }

  .torn-paper-svg {
    position: relative;
    display: block;
    width: 100%;
    height: clamp(45px, 6vw, 75px);
  }

  /* About Story Section */
  .mp-about-story {
    padding-top: clamp(60px, 7vw, 90px);
    padding-bottom: clamp(60px, 7vw, 90px);
    background-color: #ffffff;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(36px, 5vw, 64px);
    align-items: flex-start;
  }

  @media (max-width: 992px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .about-text-col p {
    font-size: 0.9375rem;
    color: #475569;
    line-height: 1.72;
    margin-bottom: 16px;
  }

  .about-text-col p.lead-text {
    font-size: 1.1rem;
    font-weight: 500;
    color: #1e293b;
    line-height: 1.65;
  }

  .quote-highlight-box {
    margin-top: 28px;
    padding: 22px 24px;
    background: #fafaf9;
    border-left: 4px solid var(--mp-red);
    border-radius: 0 16px 16px 0;
  }

  .quote-highlight-box p {
    font-style: italic;
    color: #334155;
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 8px 0 0 0;
  }

  .about-cards-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feature-card {
    display: flex;
    gap: 16px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 20px 22px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

