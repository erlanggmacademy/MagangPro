---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const pageTitle = "Pelatihan Digital Marketing UMKM di Malang | MagangPro";
const pageDescription = "Program pelatihan dan pendampingan digital marketing praktis khusus pelaku UMKM di Kota Malang. Optimasi Google Bisnis Profil, konten media sosial, dan teknik closing WhatsApp.";

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Pelatihan & Jasa', href: '/pelatihan-digital-marketing' },
  { label: 'Pelatihan untuk UMKM' },
];

const pillars = [
  {
    num: '01',
    title: 'Dominasi Google Maps (Local SEO)',
    desc: 'Menempatkan toko/bisnis Anda di urutan 3 besar Google Maps saat calon pembeli di Malang mencari produk Anda. Termasuk verifikasi titik lokasi, jam buka, dan katalog produk.',
    benefit: 'Pelanggan lokal sekitar langsung menemukan toko dan menekan tombol telepon/rute.',
  },
  {
    num: '02',
    title: 'Video Konten Promosi Cukup dari HP',
    desc: 'Teknik merekam produk yang menarik, pencahayaan alami sederhana, serta editing cepat memakai CapCut tanpa butuh kamera mahal atau tim desainer rumit.',
    benefit: 'Bisa konsisten mengunggah konten Reels & TikTok yang mengundang rasa penasaran pembeli.',
  },
  {
    num: '03',
    title: 'Manajemen Leads & Closing WhatsApp',
    desc: 'Pengaturan WhatsApp Business profesional dengan label pesanan, katalog digital, pesan otomatis di luar jam kerja, dan template salam ramah yang mempercepat closing.',
    benefit: 'Tingkat konversi chat menjadi transaksi pembelian meningkat signifikan.',
  },
  {
    num: '04',
    title: 'Riset Kata Kunci Produk Berdaya Beli',
    desc: 'Mencari kata kunci yang benar-benar diketikkan orang saat ingin membeli produk Anda di Google (misal: "konveksi kaos malang", "katering harian lowokwaru").',
    benefit: 'Menghindari buang waktu membuat konten yang tidak ada pencariannya.',
  },
];

const formats = [
  {
    title: 'Workshop Intensif 1 Hari',
    badge: 'Paling Populer',
    desc: 'Kelas tatap muka berkapasitas terbatas (6–10 peserta) di studio MagangPro Mojolangu Malang. Langsung praktik di laptop/HP masing-masing.',
    features: ['Durasi 6 jam materi & praktik langsung', 'Modul panduan langkah demi langkah', 'Grup konsultasi lanjutan via WhatsApp', 'Makan siang & sertifikat workshop'],
  },
  {
    title: 'Private Mentoring 1-on-1',
    badge: 'Eksklusif & Fokus',
    desc: 'Sesi pendampingan privat antara mentor praktisi dengan Anda (beserta maks. 2 staf inti usaha). Bedah tuntas strategi khusus untuk brand Anda.',
    features: ['Audit mendalam akun bisnis Anda', 'Jadwal fleksibel sesuai kesepakatan', 'Dibuatkan roadmap promosi 30 hari', 'Asistensi teknis prioritas langsung'],
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- 1. Unified Page Banner -->
  <PageBanner
    pill="Solusi Usaha Mikro, Kecil & Menengah"
    title="Pelatihan untuk UMKM"
    description="Panduan praktis langkah demi langkah bagi pemilik usaha lokal untuk mendatangkan pelanggan baru dari pencarian Google dan media sosial tanpa biaya iklan mahal."
    breadcrumbs={breadcrumbs}
  />

  <!-- 2. Section Masalah & Solusi UMKM -->
  <section class="mp-section" id="intro-umkm">
    <div class="mp-container">
      <div class="umkm-intro-grid">
        <div class="umkm-img-col">
          <img
            src="/images/services/pelatihan-umkm.webp"
            alt="Pelatihan Digital Marketing UMKM Malang"
            width="600"
            height="400"
            loading="lazy"
            decoding="async"
            class="umkm-hero-img"
          />
          <div class="stat-pill-float">
            <strong>Fokus Praktik</strong>
            <span>100% Studi Kasus Nyata Bisnis Anda</span>
          </div>
        </div>

        <div class="umkm-text-col">
          <span class="eyebrow">Mengapa Pelatihan Ini Penting?</span>
          <h2 class="heading-lg">Produk Anda Bagus, Tapi Calon Pembeli Belum Tahu Tempat Anda</h2>
          <p class="lead-text">
            Banyak pelaku UMKM di Malang mengeluhkan omzet yang stagnan karena hanya mengandalkan promosi dari mulut ke mulut atau status WhatsApp pribadi yang audiensnya itu-itu saja.
          </p>
          <p>
            Di sisi lain, setiap hari ribuan orang di Malang mengetikkan pencarian produk dan jasa di Google Maps dan media sosial. Program pelatihan MagangPro hadir untuk memastikan bisnis Anda menjadi jawaban pertama yang mereka temukan saat butuh produk Anda.
          </p>

          <div class="pain-solution-list">
            <div class="ps-item">
              <span class="cross-icon">✕</span>
              <span><strong>Sebelum:</strong> Bingung cara promosi online, takut biaya iklan mahal.</span>
            </div>
            <div class="ps-item">
              <span class="check-icon">✓</span>
              <span><strong>Sesudah:</strong> Menguasai optimasi gratisan di Google Maps & video konten mandiri.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Section 4 Pilar Jurus Praktis UMKM -->
  <section class="mp-section mp-section--surface" id="materi-umkm">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Kurikulum Ringkas & Berdampak</span>
        <h2 class="heading-lg">4 Jurus Praktis yang Langsung Diterapkan</h2>
        <p>Tidak ada teori akademis yang berbelit. Kami langsung menunjukkan tombol mana yang harus ditekan dan cara mengeksekusinya.</p>
      </div>

      <div class="pillars-grid">
        {pillars.map((p) => (
          <div class="pillar-card">
            <span class="pillar-num">{p.num}</span>
            <h3 class="pillar-title">{p.title}</h3>
            <p class="pillar-desc">{p.desc}</p>
            <div class="pillar-benefit">
              <strong>Hasil yang Didapat:</strong> {p.benefit}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Section Pilihan Format Pelatihan -->
  <section class="mp-section" id="format-pelatihan">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Pilihan Kelas</span>
        <h2 class="heading-lg">Pilih Format yang Paling Sesuai Kebutuhan Usaha Anda</h2>
        <p>Tersedia kelas workshop bersama wirausahawan lain atau sesi bimbingan private intensif.</p>
      </div>

      <div class="formats-grid">
        {formats.map((f) => (
          <div class="format-card">
            <div class="format-header">
              <span class="format-badge">{f.badge}</span>
              <h3 class="format-title">{f.title}</h3>
              <p class="format-desc">{f.desc}</p>
            </div>

            <ul class="format-features">
              {f.features.map((feat) => (
                <li>
                  <span class="feat-chk">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>

            <div class="format-action">
              <WhatsAppButton
                label="Konsultasi Jadwal Kelas Ini"
                message={`Halo MagangPro, saya pelaku UMKM tertarik mengikuti program: ${f.title}. Kapan jadwal kelas terdekat?`}
                variant="primary"
                size="md"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Unified Closing CTA Banner -->
  <CtaBanner
    eyebrow="Tingkatkan Omzet Sekarang"
    title="Siap Mengembangkan Bisnis Lokal Anda Bersama MagangPro?"
    desc="Diskusikan kendala pemasaran bisnis Anda dan dapatkan arahan strategi yang tepat dari praktisi kami di Kota Malang."
    waLabel="Konsultasi Usaha via WhatsApp"
    waMessage="Halo MagangPro, saya pemilik UMKM ingin berkonsultasi mengenai pendampingan digital marketing."
  />
</BaseLayout>

<style>
  /* UMKM Intro */
  .umkm-intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  @media (max-width: 900px) {
    .umkm-intro-grid {
      grid-template-columns: 1fr;
    }
  }

  .umkm-img-col {
    position: relative;
  }

  .umkm-hero-img {
    width: 100%;
    height: auto;
    border-radius: 24px;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.09);
    object-fit: cover;
  }

  .stat-pill-float {
    position: absolute;
    bottom: -16px;
    right: 20px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 12px 20px;
    border-radius: 14px;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
    display: flex;
    flex-direction: column;
  }

  .stat-pill-float strong {
    font-family: var(--mp-font-heading);
    color: var(--mp-red);
    font-size: 0.95rem;
  }

  .stat-pill-float span {
    font-size: 0.78rem;
    color: #64748b;
  }

  .lead-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #1e293b;
    margin-bottom: 16px;
    font-weight: 500;
  }

  .umkm-text-col p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #475569;
    margin-bottom: 22px;
  }

  .pain-solution-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ps-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.88rem;
    color: #334155;
    line-height: 1.5;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 12px 16px;
  }

  .cross-icon {
    color: #ef4444;
    font-weight: 800;
    font-size: 0.9rem;
  }

  .check-icon {
    color: #16a34a;
    font-weight: 800;
    font-size: 0.9rem;
  }

  /* Pillars Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    max-width: 1040px;
    margin-inline: auto;
  }

  @media (max-width: 780px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
  }

  .pillar-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    padding: clamp(26px, 3.5vw, 34px);
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pillar-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
  }

  .pillar-num {
    font-family: var(--mp-font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--mp-red);
    line-height: 1;
    margin-bottom: 12px;
  }

  .pillar-title {
    font-family: var(--mp-font-heading);
    font-size: 1.25rem;
    color: #0f172a;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .pillar-desc {
    font-size: 0.88rem;
    color: #475569;
    line-height: 1.65;
    margin-bottom: 18px;
    flex-grow: 1;
  }

  .pillar-benefit {
    background: #f8fafc;
    border-left: 3px solid #16a34a;
    padding: 10px 14px;
    border-radius: 0 8px 8px 0;
    font-size: 0.82rem;
    color: #334155;
    line-height: 1.5;
  }

  .pillar-benefit strong {
    color: #0f172a;
  }

  /* Formats Grid */
  .formats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    max-width: 980px;
    margin-inline: auto;
  }

  @media (max-width: 820px) {
    .formats-grid {
      grid-template-columns: 1fr;
    }
  }

  .format-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: clamp(28px, 4vw, 38px);
    box-shadow: 0 6px 22px rgba(15, 23, 42, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .format-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.09);
    border-color: rgba(198, 40, 40, 0.35);
  }

  .format-header {
    margin-bottom: 22px;
  }

  .format-badge {
    display: inline-block;
    background: rgba(198, 40, 40, 0.1);
    color: var(--mp-red);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 9999px;
    margin-bottom: 12px;
  }

  .format-title {
    font-family: var(--mp-font-heading);
    font-size: 1.4rem;
    color: #0f172a;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .format-desc {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  .format-features {
    list-style: none;
    padding: 0;
    margin: 0 0 28px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .format-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.86rem;
    color: #334155;
    line-height: 1.5;
  }

  .feat-chk {
    color: #16a34a;
    font-weight: 800;
    font-size: 0.85rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .format-action {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: auto;
  }

  .format-action :global(.mp-button) {
    width: 100%;
    justify-content: center;
  }
</style>
