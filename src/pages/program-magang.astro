---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { mainPrograms, internshipPositions } from '../data/programs';

const pageTitle = "Program Magang SMK & Internship Mahasiswa di Malang | MagangPro";
const pageDescription = "Informasi lengkap program magang SMK (PKL) dan internship mahasiswa di bidang Web Development, Digital Marketing, UI/UX, Multimedia, dan IT Support di Mojolangu, Kota Malang.";

const programFaqs = [
  {
    question: "Apakah ada biaya pendaftaran untuk program magang di MagangPro?",
    answer: "Tidak ada biaya pendaftaran tersembunyi. Program magang di MagangPro difokuskan sebagai inkubator talenta muda berbasis proyek industri nyata. Penerimaan dilakukan berdasarkan kesesuaian jurusan, kesiapan komitmen belajar, dan kuota mentor yang tersedia."
  },
  {
    question: "Bagaimana jika kemampuan teknis saya masih pemula (belum mahir coding/desain)?",
    answer: "Tidak masalah. Kami memahami bahwa magang adalah proses belajar. Mentor kami akan memberikan orientasi awal dan mengarahkan penugasan secara bertahap mulai dari pemahaman standar industri hingga implementasi proyek nyata."
  },
  {
    question: "Apakah MagangPro membantu pengisian nilai dan lembar laporan PKL sekolah/kampus?",
    answer: "Pasti. Kami membantu memverifikasi jurnal harian/mingguan (logbook), mengisi lembar evaluasi berkala, memberikan penilaian objektif, serta menandatangani laporan magang resmi yang dibutuhkan institusi pendidikan Anda."
  },
  {
    question: "Apakah bisa mendaftar secara berkelompok dari sekolah yang sama?",
    answer: "Bisa, pendaftaran rombongan sekolah (misal 2 – 4 siswa dalam satu tim jurusan) sangat dimungkinkan selama kuota pada periode tersebut masih mencukupi. Silakan hubungi admin WhatsApp untuk koordinasi kuota sekolah."
  },
  {
    question: "Bagaimana jika saya berasal dari luar Kota Malang?",
    answer: "Peserta dari luar Malang sangat dipersilakan mendaftar. Lokasi studio kami di Mojolangu berada di sentra kos mahasiswa yang sangat strategis, aman, dan mudah diakses dari berbagai penjuru Malang Raya."
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: programFaqs.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- 1. Page Banner with Organic Torn Paper Bottom (Hitam Burem Putih Theme) -->
  <section class="mp-page-banner">
    <div class="banner-ambient-glow" aria-hidden="true"></div>
    <div class="banner-grid-pattern" aria-hidden="true"></div>

    <div class="mp-container banner-content">
      <!-- Pill Eyebrow (Matching Reference Style) -->
      <div class="banner-pill">
        <span>Pilihan Jalur Magang Industri</span>
      </div>

      <!-- Main Headline (Simple & Impactful) -->
      <h1 class="page-banner-title">
        Program Magang
      </h1>

      <!-- Simple Description -->
      <p class="page-banner-desc">
        Pilihan jalur Praktik Kerja Lapangan (PKL) SMK dan internship mahasiswa dengan kurikulum berbasis proyek industri nyata di Kota Malang.
      </p>

      <!-- Plain Text Breadcrumb (Placed Below Description) -->
      <nav class="banner-breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Beranda</a></li>
          <li class="separator" aria-hidden="true">/</li>
          <li class="active" aria-current="page">Program Magang</li>
        </ol>
      </nav>
    </div>

    <!-- Dual-Layered Natural Organic Torn Paper Bottom Divider -->
    <div class="torn-paper-divider" aria-hidden="true">
      <svg
        class="torn-paper-svg"
        viewBox="0 0 1440 100"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Back Shadow / Fibrous Underlay for 3D Torn Paper Depth -->
        <path
          d="M0,100 L0,41 L9,40 L21,45 L32,41 L44,46 L53,49 L65,46 L81,48 L96,50 L106,51 L114,41 L122,44 L141,47 L160,44 L176,42 L186,42 L202,35 L219,35 L235,32 L249,32 L264,33 L274,39 L286,39 L304,34 L322,35 L331,40 L350,43 L361,46 L377,40 L397,42 L411,44 L419,44 L433,39 L442,42 L461,38 L471,36 L488,41 L505,35 L522,42 L531,34 L544,40 L562,35 L582,42 L592,43 L613,47 L631,44 L639,46 L656,54 L675,57 L696,55 L705,55 L720,53 L741,46 L756,51 L776,49 L796,45 L804,42 L817,42 L834,34 L847,39 L856,36 L870,34 L889,36 L906,38 L918,35 L932,38 L941,37 L959,33 L972,33 L981,36 L992,35 L1007,30 L1025,32 L1036,28 L1056,27 L1072,28 L1086,17 L1105,19 L1119,18 L1132,14 L1141,13 L1157,12 L1165,9 L1186,10 L1206,13 L1220,11 L1234,16 L1255,13 L1265,14 L1273,16 L1294,19 L1313,25 L1327,21 L1340,22 L1354,31 L1370,20 L1378,29 L1395,26 L1416,22 L1440,22 L1440,100 Z"
          fill="rgba(255, 255, 255, 0.45)"
        />
        <!-- Front Crisp Torn Paper Edge (Seamless into white section below) -->
        <path
          d="M0,100 L0,61 L16,60 L36,59 L54,61 L73,60 L86,65 L96,61 L106,62 L122,63 L134,58 L146,62 L154,57 L163,58 L183,54 L201,52 L212,49 L231,47 L242,52 L261,47 L273,47 L287,48 L302,53 L318,53 L330,54 L340,57 L360,58 L368,57 L384,59 L403,56 L415,54 L423,55 L444,51 L460,58 L474,56 L494,50 L509,54 L519,50 L532,53 L541,50 L561,49 L576,52 L587,53 L604,57 L621,65 L632,59 L641,64 L662,63 L682,67 L700,67 L713,67 L732,60 L745,66 L762,62 L778,64 L793,61 L808,55 L819,51 L833,53 L846,54 L863,56 L881,52 L896,48 L911,48 L927,51 L945,55 L961,46 L976,47 L993,48 L1011,49 L1031,42 L1040,47 L1061,41 L1082,42 L1090,33 L1101,37 L1122,33 L1136,27 L1154,25 L1172,24 L1191,27 L1207,27 L1225,23 L1234,30 L1244,26 L1260,32 L1281,35 L1291,31 L1305,34 L1322,40 L1338,42 L1349,38 L1368,40 L1386,41 L1403,37 L1411,39 L1431,33 L1440,36 L1440,100 Z"
          fill="#ffffff"
        />
      </svg>
    </div>
  </section>

  <!-- 2. Section Dua Jalur Utama: PKL SMK & Internship Mahasiswa -->
  <section class="mp-section" id="jalur-magang">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Pilihan Jalur</span>
        <h2 class="heading-lg">Program Dirancang Sesuai Jenjang Akademis</h2>
        <p>
          Materi pembelajaran, standar penugasan, dan pendampingan laporan disusun khusus agar tepat sasaran untuk siswa SMK maupun mahasiswa.
        </p>
      </div>

      <div class="two-programs-grid">
        {mainPrograms.map((program) => (
          <div class="detailed-program-card">
            <div class="card-top-header">
              <span class="program-badge-pill">{program.badge}</span>
              <h3 class="program-card-title">{program.title}</h3>
              <p class="program-target-info">
                <strong>Sasaran:</strong> {program.target}
              </p>
            </div>

            <p class="program-card-desc">{program.description}</p>

            <div class="program-highlights-box">
              <span class="highlights-heading">Benefit & Keunggulan Jalur:</span>
              <ul class="highlights-list">
                {program.highlights.map((h) => (
                  <li>
                    <span class="check-icon">✓</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="card-footer-action">
              <WhatsAppButton
                label="Konsultasi Kuota Jalur Ini"
                message={program.waMessage}
                variant="primary"
                size="md"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Section Bidang & Posisi Magang yang Tersedia -->
  <section class="mp-section mp-section--surface" id="posisi-magang">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Bidang & Kompetensi</span>
        <h2 class="heading-lg">6 Posisi Magang yang Dapat Dipilih</h2>
        <p>
          Pilih divisi sesuai minat dan keahlian jurusan Anda untuk membangun portofolio proyek industri yang terverifikasi.
        </p>
      </div>

      <div class="positions-grid">
        {internshipPositions.map((pos) => (
          <div class="position-item-card">
            <div class="pos-header">
              <span class="pos-dept-tag">{pos.department}</span>
              <span class="pos-status-badge">Tersedia</span>
            </div>

            <h3 class="pos-title">{pos.title}</h3>
            <p class="pos-target-tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
              <span>{pos.targetAudience}</span>
            </p>

            <p class="pos-desc">{pos.description}</p>

            <div class="pos-skills-wrap">
              <span class="skills-label">Skill yang Dibangun:</span>
              <div class="skills-pills">
                {pos.skills.map((skill) => (
                  <span class="skill-tag">{skill}</span>
                ))}
              </div>
            </div>

            <div class="pos-action">
              <a
                href={`https://wa.me/62895639068080?text=${encodeURIComponent(`Halo MagangPro, saya ingin mendaftar posisi: ${pos.title}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="pos-btn"
              >
                <span>Tanya Detail Posisi</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Section Alur Pendaftaran Magang -->
  <section class="mp-section" id="alur-pendaftaran">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Tahapan Pendaftaran</span>
        <h2 class="heading-lg">4 Langkah Mudah Alur Pendaftaran</h2>
        <p>Proses administrasi cepat, transparan, dan terarah bagi siswa, mahasiswa, maupun guru pembimbing.</p>
      </div>

      <div class="steps-flow-grid">
        <div class="step-card">
          <div class="step-number">01</div>
          <h3>Pilih Bidang & Konsultasi</h3>
          <p>Diskusikan ketersediaan kuota periode dan divisi yang sesuai dengan jurusan Anda via WhatsApp Admin.</p>
        </div>

        <div class="step-card">
          <div class="step-number">02</div>
          <h3>Pengajuan Berkas Resmi</h3>
          <p>Kirimkan surat permohonan magang dari sekolah/kampus serta CV singkat untuk penerbitan surat balasan penerimaan.</p>
        </div>

        <div class="step-card">
          <div class="step-number">03</div>
          <h3>Onboarding & Mentoring</h3>
          <p>Pengenalan lab onsite di Mojolangu Malang, pembagian mentor pembimbing, dan penyusunan timeline tugas riil.</p>
        </div>

        <div class="step-card">
          <div class="step-number">04</div>
          <h3>Evaluasi & Sertifikasi</h3>
          <p>Penyusunan portofolio akhir, bimbingan lembar laporan PKL, serta penerbitan sertifikat magang resmi berpredikat.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Section Fasilitas & Manfaat Peserta -->
  <section class="mp-section mp-section--surface" id="manfaat-peserta">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Output Nyata</span>
        <h2 class="heading-lg">Apa yang Anda Dapatkan Selama Magang?</h2>
        <p>Setiap jam yang Anda habiskan di MagangPro didesain untuk menjadi investasi karier masa depan Anda.</p>
      </div>

      <div class="benefits-grid">
        <div class="benefit-box">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3>Portofolio Karya Riil</h3>
          <p>Mengerjakan website aktif, perancangan identitas visual, atau optimasi Google Bisnis UMKM yang dapat dilampirkan di CV & LinkedIn.</p>
        </div>

        <div class="benefit-box">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3>1-on-1 Mentoring Praktisi</h3>
          <p>Bimbingan langsung dari software engineer, digital marketer, dan desainer industri yang siap menjawab kendala teknis harian.</p>
        </div>

        <div class="benefit-box">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <h3>Bimbingan Laporan Resmi</h3>
          <p>Asistensi penyusunan materi bab laporan magang sekolah/kampus, penilaian objektif, serta tanda tangan pembimbing industri.</p>
        </div>

        <div class="benefit-box">
          <div class="benefit-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="7"></circle>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
            </svg>
          </div>
          <h3>Sertifikat Terverifikasi</h3>
          <p>Sertifikat resmi tanda kelulusan magang dengan rincian nilai kompetensi dan deskripsi proyek nyata yang telah diselesaikan.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Section Persyaratan & Durasi / Jadwal Pelaksanaan -->
  <section class="mp-section" id="persyaratan-jadwal">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Persyaratan & Durasi</span>
        <h2 class="heading-lg">Kualifikasi Pendaftaran & Ketentuan Waktu</h2>
        <p>Informasi mendasar sebelum mengajukan surat permohonan resmi dari pihak sekolah atau kampus Anda.</p>
      </div>

      <div class="req-schedule-grid">
        <!-- Kolom 1: Persyaratan Berkas & Perangkat -->
        <div class="req-card">
          <div class="card-icon-title">
            <div class="mini-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <h3 class="req-card-title">Persyaratan Dokumen & Perangkat</h3>
          </div>
          <ul class="checklist-items">
            <li>
              <span class="chk-bullet">✓</span>
              <div>
                <strong>Surat Pengantar / Permohonan Magang</strong>
                <p>Surat resmi bertanda tangan dari pihak sekolah (SMK) atau dekanat fakultas (Perguruan Tinggi).</p>
              </div>
            </li>
            <li>
              <span class="chk-bullet">✓</span>
              <div>
                <strong>Status Siswa / Mahasiswa Aktif</strong>
                <p>Terdaftar aktif pada jurusan IT, Multimedia, DKV, Bisnis Digital, Pemasaran, atau jurusan terkait.</p>
              </div>
            </li>
            <li>
              <span class="chk-bullet">✓</span>
              <div>
                <strong>Membawa Laptop Pribadi</strong>
                <p>Spesifikasi kerja mandiri (rekomendasi prosesor Intel Core i3 / AMD Ryzen 3 atau setara, RAM min. 8GB).</p>
              </div>
            </li>
            <li>
              <span class="chk-bullet">✓</span>
              <div>
                <strong>Komitmen Disiplin & Kerapian</strong>
                <p>Bersedia mematuhi jam kerja onsite di Mojolangu Malang, aturan etika kerja, dan tenggat tugas proyek.</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Kolom 2: Durasi, Jam Kerja & Kuota -->
        <div class="req-card">
          <div class="card-icon-title">
            <div class="mini-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h3 class="req-card-title">Durasi, Jam Kerja & Kapasitas</h3>
          </div>
          <ul class="checklist-items">
            <li>
              <span class="chk-bullet">✓</span>
              <div>
                <strong>Durasi Fleksibel (3 - 6 Bulan)</strong>
                <p>Disesuaikan dengan kebijakan durasi PKL sekolah atau bobot SKS magang mandiri kampus (biasanya 1 semester).</p>
              </div>
            </li>
            <li>
              <span class="chk-bullet">✓</span>
              <div>
                <strong>Jadwal Operasional Onsite</strong>
                <p>Hari kerja: Senin s/d Jumat, pukul 08.30 – 16.30 WIB (istirahat 12.00 – 13.00 WIB).</p>
              </div>
            </li>
            <li>
              <span class="chk-bullet">✓</span>
              <div>
                <strong>Lokasi Studio Magang</strong>
                <p>Kawasan pendidikan Mojolangu, Kec. Lowokwaru, Kota Malang (dekat kampus-kampus besar Malang).</p>
              </div>
            </li>
            <li>
              <span class="chk-bullet">✓</span>
              <div>
                <strong>Kuota Terbatas per Gelombang</strong>
                <p>Hanya 8 – 12 peserta per batch guna menjamin kualitas asistensi 1-on-1 bersama praktisi mentor.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Section FAQ Khusus Program Magang -->
  <section class="mp-section mp-section--surface" id="faq-magang">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Tanya Jawab</span>
        <h2 class="heading-lg">Pertanyaan yang Sering Diajukan</h2>
        <p>Hal-hal yang sering ditanyakan oleh siswa, mahasiswa, maupun orang tua dan guru pendamping PKL.</p>
      </div>

      <div class="faq-accordion-list">
        {programFaqs.map((faq, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary class="faq-summary">
              <span class="faq-question">{faq.question}</span>
              <span class="faq-icon-wrapper">
                <svg class="faq-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </span>
            </summary>
            <div class="faq-content">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <!-- FAQ Schema.org JSON-LD -->
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    </div>
  </section>

  <!-- 7. Closing Call to Action Banner (Identical to Homepage for consistency) -->
  <section class="mp-section mp-cta-banner">
    <div class="mp-container">
      <div class="banner-inner">
        <span class="eyebrow eyebrow--light">Siap Memulai Langkah Baru?</span>
        <h2 class="banner-title">
          Tingkatkan Kompetensi Nyata Bersama MagangPro
        </h2>
        <p class="banner-desc">
          Jangan ragu untuk berdiskusi mengenai ketersediaan kuota magang, persyaratan sekolah/kampus, atau silabus pelatihan digital marketing untuk tim Anda.
        </p>
        <div class="banner-actions">
          <WhatsAppButton
            label="Chat WhatsApp Admin"
            message="Halo MagangPro, saya ingin bertanya lebih lanjut mengenai program magang yang tersedia."
            variant="whatsapp"
            size="lg"
          />
        </div>
        <div class="banner-location">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Mojolangu, Kota Malang, Jawa Timur 65142</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Page Banner: Cinematic Monochrome Black with Soft White Mist (Hitam Burem Putih kaya Hero) */
  .mp-page-banner {
    position: relative;
    background-color: #060606;
    color: #ffffff;
    padding-top: clamp(65px, 8vw, 100px);
    padding-bottom: clamp(100px, 12vw, 140px); /* extra padding for torn paper */
    overflow: hidden;
