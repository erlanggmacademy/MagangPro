---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { blogPosts, type BlogPost } from '../../data/blog';

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// 3 related articles (exclude current post)
const relatedPosts = blogPosts
  .filter((p) => p.slug !== post.slug)
  .slice(0, 3);

const pageTitle = `${post.title} | Blog MagangPro Malang`;
const pageDescription = post.excerpt;

// Schema JSON-LD (SEO, AEO, GEO) for Article & FAQPage
const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `https://programmagang.web.id/blog/${post.slug}#article`,
      headline: post.title,
      description: post.excerpt,
      image: [
        `https://programmagang.web.id${post.image}`,
        `https://programmagang.web.id${post.secondImage.src}`
      ],
      datePublished: '2026-10-30T08:00:00+07:00',
      dateModified: '2026-10-30T08:00:00+07:00',
      author: {
        '@type': 'Person',
        name: post.author.name,
        jobTitle: post.author.role,
        url: 'https://programmagang.web.id/tentang-kami'
      },
      publisher: {
        '@type': 'Organization',
        name: 'MagangPro',
        url: 'https://programmagang.web.id/',
        logo: {
          '@type': 'ImageObject',
          url: 'https://programmagang.web.id/images/logo-magangpro.webp'
        }
      },
      mainEntityOfPage: `https://programmagang.web.id/blog/${post.slug}`
    },
    {
      '@type': 'FAQPage',
      '@id': `https://programmagang.web.id/blog/${post.slug}#faq`,
      mainEntity: post.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={`https://programmagang.web.id${post.image}`}
  pageSchema={articleSchema}
>
  <!-- Article Main Content (Clean Light Layout without dark PageBanner) -->
  <article class="article-detail-page mp-section">
    <div class="mp-container article-container">
      <!-- Breadcrumb Navigation -->
      <nav class="article-breadcrumbs" aria-label="Breadcrumb">
        <a href="/" class="crumb-link">Beranda</a>
        <span class="crumb-separator">/</span>
        <a href="/blog" class="crumb-link">Blog</a>
        <span class="crumb-separator">/</span>
        <span class="crumb-current">{post.category}</span>
      </nav>

      <!-- Category Badge & Read Time -->
      <div class="article-badge-row">
        <span class="category-pill">{post.category}</span>
        <span class="read-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>{post.readTime}</span>
        </span>
      </div>

      <!-- Main Article Headline -->
      <h1 class="article-main-title">{post.title}</h1>

      <!-- Author and Date Meta Bar -->
      <div class="article-meta-bar">
        <div class="author-profile">
          <div class="author-circle" aria-hidden="true">
            {post.author.name.charAt(0)}
          </div>
          <div class="author-details">
            <span class="author-name">{post.author.name}</span>
            <span class="author-role">{post.author.role}</span>
          </div>
        </div>

        <div class="meta-date-box">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Dipublikasikan: <strong>{post.date}</strong></span>
        </div>
      </div>

      <!-- Featured Cover Image (#1) -->
      <div class="featured-image-wrapper">
        <img
          src={post.image}
          alt={post.title}
          width="1100"
          height="550"
          loading="eager"
          decoding="async"
          class="featured-hero-img"
        />
      </div>

      <div class="article-content-layout">
        <!-- Main Reading Body -->
        <div class="article-body">
          <!-- Lead Intro Paragraph -->
          <p class="article-lead-text">
            {post.intro}
          </p>

          <!-- 1. Collapsible Table of Contents (Buka/Tutup) -->
          <details class="table-of-contents-box" open>
            <summary class="toc-summary">
              <div class="toc-title-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                <span class="toc-title">Daftar Isi Pembahasan</span>
              </div>
              <span class="toc-toggle-indicator">
                <span class="toggle-text">Buka / Tutup</span>
                <svg class="toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <ol class="toc-list">
              {post.sections.map((sec, idx) => (
                <li>
                  <a href={`#section-${idx + 1}`}>{sec.heading}</a>
                </li>
              ))}
              <li>
                <a href="#section-kesimpulan">Kesimpulan</a>
              </li>
              <li>
                <a href="#section-faq">Pertanyaan Sering Diajukan (FAQ)</a>
              </li>
            </ol>
          </details>

          <!-- Section 1 & 2 -->
          {post.sections.slice(0, 2).map((sec, idx) => (
            <section class="content-section" id={`section-${idx + 1}`}>
              <h2 class="section-subheading">{sec.heading}</h2>

              {sec.body.map((p) => (
                <p class="section-paragraph">{p}</p>
              ))}

              {sec.quote && (
                <blockquote class="article-quote-box">
                  <p>"{sec.quote}"</p>
                </blockquote>
              )}

              {sec.list && sec.list.length > 0 && (
                <ul class="section-check-list">
                  {sec.list.map((item) => (
                    <li>
                      <span class="bullet-check">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}

          <!-- 2. "Baca Juga" Inline Callout -->
          <aside class="inline-read-also" aria-label="Artikel Rekomendasi">
            <div class="read-also-tag">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
              <span>BACA JUGA:</span>
            </div>
            <a href={`/blog/${post.readAlso.slug}`} class="read-also-link">
              <span>{post.readAlso.title}</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </aside>

          <!-- 3. Image #2 Inside Article -->
          <figure class="article-secondary-figure">
            <div class="second-image-wrapper">
              <img
                src={post.secondImage.src}
                alt={post.secondImage.alt}
                width="800"
                height="450"
                loading="lazy"
                decoding="async"
                class="secondary-article-img"
              />
            </div>
            <figcaption class="secondary-image-caption">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              <span>{post.secondImage.caption}</span>
            </figcaption>
          </figure>

          <!-- Section 3 & onwards -->
          {post.sections.slice(2).map((sec, idx) => (
            <section class="content-section" id={`section-${idx + 3}`}>
              <h2 class="section-subheading">{sec.heading}</h2>

              {sec.body.map((p) => (
                <p class="section-paragraph">{p}</p>
              ))}

              {sec.quote && (
                <blockquote class="article-quote-box">
                  <p>"{sec.quote}"</p>
                </blockquote>
              )}

              {sec.list && sec.list.length > 0 && (
                <ul class="section-check-list">
                  {sec.list.map((item) => (
                    <li>
                      <span class="bullet-check">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}

          <!-- Conclusion Section -->
          <div class="article-conclusion-box" id="section-kesimpulan">
            <h3 class="conclusion-title">Kesimpulan</h3>
            <p>{post.conclusion}</p>
          </div>

          <!-- 4. FAQ Section under Conclusion -->
          <section class="article-faq-section" id="section-faq">
            <div class="faq-header">
              <span class="faq-badge">TANYA JAWAB</span>
              <h3 class="faq-section-title">Pertanyaan Sering Diajukan (FAQ)</h3>
              <p class="faq-section-desc">Jawaban ringkas seputar pembahasan topik artikel ini.</p>
            </div>

            <div class="faq-accordion-list">
              {post.faqs.map((faq, idx) => (
                <details class="faq-item" open={idx === 0}>
                  <summary class="faq-question">
                    <span>{faq.question}</span>
                    <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </summary>
                  <div class="faq-answer">
                    <p>{faq.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>

          <!-- Tags Bar -->
          <div class="article-tags-row">
            <span class="tags-label">Topik Terkait:</span>
            <div class="tags-pills">
              {post.tags.map((t) => (
                <span class="topic-tag-pill">#{t}</span>
              ))}
            </div>
          </div>

          <!-- In-Article Action Box -->
          <div class="article-action-banner">
            <div class="action-banner-content">
              <span class="banner-badge">{post.ctaBox.badge}</span>
              <h3 class="banner-title">{post.ctaBox.title}</h3>
              <p class="banner-desc">{post.ctaBox.desc}</p>
            </div>
            <div class="banner-btn-wrap">
              <a href={post.ctaBox.btnHref} class="banner-cta-button">
                <span>{post.ctaBox.btnLabel}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>

          <!-- Author Bio Card -->
          <div class="author-bio-card">
            <div class="bio-avatar" aria-hidden="true">
              {post.author.name.charAt(0)}
            </div>
            <div class="bio-info">
              <h4 class="bio-name">{post.author.name}</h4>
              <p class="bio-role">{post.author.role} di MagangPro Malang</p>
              <p class="bio-desc">
                Berdedikasi dalam mendampingi talenta muda vokasi dan mahasiswa untuk menjembatani kurikulum pendidikan dengan standar kompetensi industri teknologi dan pemasaran digital modern.
              </p>
            </div>
          </div>

          <!-- 5. "Bagikan Artikel" (Replaces "Kembali ke Semua Artikel") -->
          <div class="article-share-section">
            <div class="share-header">
              <div class="share-title-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="18" cy="5" r="3"></circle>
                  <circle cx="6" cy="12" r="3"></circle>
                  <circle cx="18" cy="19" r="3"></circle>
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                  <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                </svg>
                <span class="share-heading">Bagikan Artikel Ini:</span>
              </div>
              <span class="share-desc">Bantu rekan dan teman Anda menemukan wawasan bermanfaat ini.</span>
            </div>

            <div class="share-buttons-grid">
              <!-- WhatsApp -->
              <a
                href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.title}\n\nBaca artikel selengkapnya di: https://programmagang.web.id/blog/${post.slug}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="social-share-btn btn-wa"
                aria-label="Bagikan ke WhatsApp"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.587 1.961.947 2.801.947h.005c3.178 0 5.767-2.587 5.768-5.766.001-3.181-2.587-5.767-5.778-5.767zm7.423 5.765c-.002 4.091-3.328 7.417-7.421 7.417-.1.001-2.586-.549-3.414-.997l-3.805.998 1.018-3.719c-.488-.847-.746-1.815-.745-2.809.002-4.091 3.328-7.417 7.422-7.417 4.092 0 7.424 3.326 7.425 7.417z"></path>
                </svg>
                <span>WhatsApp</span>
              </a>

              <!-- Facebook -->
              <a
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://programmagang.web.id/blog/${post.slug}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="social-share-btn btn-fb"
                aria-label="Bagikan ke Facebook"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
                <span>Facebook</span>
              </a>

              <!-- LinkedIn -->
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://programmagang.web.id/blog/${post.slug}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="social-share-btn btn-li"
                aria-label="Bagikan ke LinkedIn"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"></path>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
                <span>LinkedIn</span>
              </a>

              <!-- Copy Link Button with Live Tooltip -->
              <button
                type="button"
                class="social-share-btn btn-copy"
                id="copy-article-link-btn"
                aria-label="Salin tautan artikel ke clipboard"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="copy-btn-text">Salin Tautan</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Related Articles (3 Cards Per Row) -->
  <section class="mp-section mp-section--surface related-articles-section">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Rekomendasi Bacaan</span>
        <h2 class="heading-lg">Artikel Terkait Lainnya</h2>
        <p>Perluas wawasan digital dan panduan karier Anda melalui artikel edukatif lainnya.</p>
      </div>

      <div class="related-grid-3col">
        {relatedPosts.map((item) => (
          <article class="related-blog-card">
            <a href={`/blog/${item.slug}`} class="related-thumb-link" tabindex="-1">
              <div class="related-thumb-box">
                <img
                  src={item.image}
                  alt={item.title}
                  width="400"
                  height="240"
                  loading="lazy"
                  decoding="async"
                  class="related-img"
                />
                <span class="related-badge">{item.category}</span>
              </div>
            </a>

            <div class="related-body">
              <div class="related-meta">
                <span>{item.date}</span>
                <span>•</span>
                <span>{item.readTime}</span>
              </div>

              <h3 class="related-title">
                <a href={`/blog/${item.slug}`} class="related-title-link">
                  {item.title}
                </a>
              </h3>

              <p class="related-excerpt">{item.excerpt}</p>

              <div class="related-footer">
                <a href={`/blog/${item.slug}`} class="related-read-btn">
                  <span>Baca Artikel</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Unified Closing CTA Banner -->
  <CtaBanner
    eyebrow="Siap Mengembangkan Diri Bersama Kami?"
    title="Wujudkan Karier Impian di Dunia Digital Bersama MagangPro Malang"
    desc="Dapatkan pembekalan langsung di proyek industri nyata dengan mentoring intensif di Kota Malang."
    primaryBtn={{
      label: "Daftar Program Magang",
      href: "/program-magang"
    }}
    secondaryBtn={{
      label: "Konsultasi WhatsApp",
      href: "https://wa.me/62895639068080?text=Halo%20MagangPro,%20saya%20tertarik%20dengan%20program%20di%20MagangPro."
    }}
  />
</BaseLayout>

<script>
  // Copy Link Button Handler
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-article-link-btn');
    const copyText = document.getElementById('copy-btn-text');

    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalText = copyText.textContent;
          copyText.textContent = 'Tersalin! ✓';
          copyBtn.classList.add('copied');

          setTimeout(() => {
            copyText.textContent = originalText;
            copyBtn.classList.remove('copied');
          }, 2500);
        } catch (err) {
          console.error('Failed to copy: ', err);
        }
      });
    }
  });
</script>

<style>
  /* ----------------------------------------------------
     ARTICLE DETAIL WRAPPER (LIGHT CLEAN THEME)
     ---------------------------------------------------- */
  .article-detail-page {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background-color: var(--mp-white);
  }

  .article-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .article-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--mp-muted);
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .crumb-link {
    color: var(--mp-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .crumb-link:hover {
    color: var(--mp-red);
  }

  .crumb-separator {
    color: #cbd5e1;
  }

  .crumb-current {
    color: var(--mp-ink);
    font-weight: 600;
  }

  .article-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .category-pill {
    display: inline-block;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    background-color: var(--mp-red-soft);
    border: 1px solid rgba(198, 40, 40, 0.18);
    color: var(--mp-red);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.3px;
  }

  .read-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--mp-muted);
    background-color: var(--mp-surface);
    border: 1px solid var(--mp-border);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }

  .article-main-title {
    font-family: var(--mp-font-heading);
    font-size: clamp(2rem, 4.2vw, 2.85rem);
    font-weight: 800;
    line-height: 1.3;
    color: var(--mp-ink);
    margin-bottom: 1.5rem;
    letter-spacing: -0.5px;
  }

  .article-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.15rem 0;
    border-top: 1px solid var(--mp-border);
    border-bottom: 1px solid var(--mp-border);
    margin-bottom: 2.25rem;
    flex-wrap: wrap;
  }

  .author-profile {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .author-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ef4444, #991b1b);
    color: #ffffff;
    display: flex;
    align-items: center;
