const pelatihanGallery: GalleryPhoto[] = [
  {
    image: '/images/portfolio/pelatihan-1.webp',
    title: 'Workshop Digital Marketing Mahasiswa',
    badge: 'Edukasi Kampus',
    desc: 'Pelatihan intensif praktik digital marketing dan optimasi konten berbasis studi kasus industri.'
  },
  {
    image: '/images/portfolio/pelatihan-2.webp',
    title: 'Pelatihan Digital Marketing SEO & Medsos',
    badge: 'SMK Sunan Drajat',
    desc: 'Sesi workshop di lab komputer mengajarkan teknik dominasi Google dan pembuatan konten promosi.'
  },
  {
    image: '/images/portfolio/pelatihan-3.webp',
    title: 'Pelatihan Analisa Usaha & Pemasaran',
    badge: 'Instansi Pemerintah',
    desc: 'Program bimbingan teknis bersama UPT dinas pemerintahan terkait strategi pemasaran produk.'
  },
  {
    image: '/images/portfolio/pelatihan-4.webp',
    title: 'Edukasi Literasi Digital Pelajar',
    badge: 'Kelas Vokasi',
    desc: 'Pemaparan komprehensif kepada siswa di ruang kelas mengenai peluang karier di era industri digital.'
  },
  {
    image: '/images/portfolio/pelatihan-5.webp',
    title: 'Bimtek Pemasaran Produk Kelautan',
    badge: 'UPT PTKP3',
    desc: 'In-house training formal bersama jajaran pengelola usaha dan aparatur terkait evaluasi pasar.'
  },
  {
    image: '/images/portfolio/pelatihan-6.webp',
    title: 'Pendampingan Praktik Konten & Pemasaran',
    badge: 'Hands-on UMKM',
    desc: 'Bimbingan tatap muka pembuatan materi promosi dan penataan toko online pelaku usaha lokal.'
  },
  {
    image: '/images/portfolio/pelatihan-7.webp',
    title: 'Rapat Strategi & Pelatihan Tim Agency',
    badge: 'Internal Training',
