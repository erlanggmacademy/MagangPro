const impactStats = [
  {
    num: '100%',
    title: 'Proyek Industri Nyata',
    desc: 'Semua karya dikerjakan langsung untuk kebutuhan klien UMKM atau sistem internal aktif, bukan sekadar tugas dummy fiktif.',
  },
  {
    num: '98/100',
    title: 'Rata-rata Skor PageSpeed',
    desc: 'Standar tinggi optimasi performa web berbasis teknologi modern Astro SSG yang cepat dan mobile-friendly.',
  },
  {
    num: '1-on-1',
    title: 'Review Praktisi Industri',
    desc: 'Setiap baris kode dan elemen desain melalui proses review teknis terarah sebelum diluncurkan ke publik.',
  },
  {
    num: 'Teruji',
    title: 'Siap untuk CV & LinkedIn',
    desc: 'Portofolio nyata yang valid dan dapat diakses publik, menjadi modal kuat saat melamar kerja setelah lulus.',
  },
];

const portfolioFlow = [
  {
    step: '01',
    title: 'Briefing Kebutuhan Klien',
    desc: 'Peserta magang menerima gambaran masalah riil dari mitra UMKM atau proyek internal, termasuk target audiens dan batasan teknis.',
  },
  {
    step: '02',
    title: 'Riset & Pengerjaan Hands-On',
    desc: 'Penyusunan kode website, riset kata kunci SEO, atau perancangan identitas visual menggunakan tools standar industri.',
  },
  {
    step: '03',
    title: 'Review & Debugging Bersama Mentor',
    desc: 'Sesi asistensi teknis berkala untuk memperbaiki kesalahan kode, menyempurnakan layout visual, dan memastikan kepatuhan standar industri.',
  },
  {
    step: '04',
    title: 'Peluncuran & Presentasi Laporan',
    desc: 'Hasil karya diluncurkan, didokumentasikan ke dalam portofolio pribadi, dan dipresentasikan sebagai materi ujian resmi PKL.',
