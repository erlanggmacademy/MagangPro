];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- 1. Unified Page Banner -->
  <PageBanner
    pill="Karya Nyata & Dokumentasi"
    title="Portofolio & Galeri"
    description="Eksplorasi portofolio proyek industri nyata yang dikembangkan peserta magang SMK dan internship mahasiswa, serta dokumentasi aktivitas mentoring harian di Kota Malang."
    breadcrumbs={breadcrumbs}
  />

  <!-- 2. Section Showcase Portofolio & Filter Interaktif -->
  <section class="mp-section" id="galeri-portofolio">
    <div class="mp-container">
      <!-- Quick Anchor Jump Bar -->
      <nav class="portfolio-section-jump" aria-label="Pintas Bagian Halaman">
        <a href="#galeri-portofolio" class="jump-pill active">
          <span>Katalog Proyek</span>
          <span class="jump-count">{portfolioData.length}</span>
        </a>
        <a href="#galeri-magang" class="jump-pill">
          <span>Galeri Magang & PKL</span>
          <span class="jump-count">{magangGallery.length}</span>
        </a>
        <a href="#galeri-pelatihan" class="jump-pill">
          <span>Galeri Pelatihan & Workshop</span>
          <span class="jump-count">{pelatihanGallery.length}</span>
        </a>
      </nav>

      <div class="section-header text-center">
        <span class="eyebrow">Katalog Proyek</span>
        <h2 class="heading-lg">Karya Nyata Peserta PixxelPro</h2>
        <p>Gunakan filter di bawah untuk melihat karya berdasarkan kategori website, pemasaran digital, desain visual, atau dokumentasi lab.</p>
      </div>

      <!-- Filter Buttons -->
      <div class="portfolio-filter-bar" role="group" aria-label="Filter Portofolio">
        <button type="button" class="filter-btn is-active" data-filter="all">Semua ({portfolioData.length})</button>
        <button type="button" class="filter-btn" data-filter="web">Website & App</button>
        <button type="button" class="filter-btn" data-filter="marketing">Digital Marketing & SEO</button>
        <button type="button" class="filter-btn" data-filter="design">Desain Grafis & DKV</button>
        <button type="button" class="filter-btn" data-filter="galeri">Galeri Kegiatan</button>
      </div>

      <!-- Portfolio Grid -->
      <div class="portfolio-cards-grid" id="portfolio-grid">
        {portfolioData.map((item) => (
          <article class="portfolio-item-card" data-category={item.category}>
            <div class="item-media-wrap">
              <img
                src={item.image}
                alt={item.title}
                width="600"
                height="380"
                loading="lazy"
                decoding="async"
                class="item-photo"
              />
              <span class="item-badge-pill">{item.badge}</span>
              <span class="item-metric-pill">{item.rating}</span>
            </div>

            <div class="item-content-body">
              <div class="item-role-tag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>{item.role}</span>
              </div>

              <h3 class="item-title">{item.title}</h3>
              <p class="item-client">
                <strong>Konteks / Klien:</strong> {item.clientOrContext}
              </p>
              <p class="item-summary">{item.summary}</p>

              <div class="item-tags-wrap">
                {item.tags.map((t) => (
                  <span class="tag-pill">{t}</span>
                ))}
              </div>

              <div class="item-action-footer">
                <a
                  href={`https://wa.me/62895639068080?text=${encodeURIComponent(`Halo PixxelPro, saya tertarik menanyakan detail portofolio: ${item.title}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inquire-btn"
                >
                  <span>{item.btnLabel}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Section Galeri Magang (9 Foto Asli) -->
  <section class="mp-section mp-section--surface" id="galeri-magang">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Dokumentasi Praktik Industri</span>
        <h2 class="heading-lg">Galeri Aktivitas Peserta Magang & PKL</h2>
        <p>Potret nyata suasana belajar, mentoring teknis harian, kerja tim kolaboratif, hingga penyelesaian proyek industri para peserta magang SMK dan mahasiswa di PixxelPro.</p>
      </div>

      <div class="real-gallery-grid">
        {magangGallery.map((item) => (
          <div
            class="gallery-photo-card"
            data-gallery-item
            data-img={item.image}
            data-title={item.title}
            data-desc={item.desc}
            data-badge={item.badge}
            role="button"
            tabindex="0"
            aria-label={`Lihat foto ${item.title}`}
          >
            <div class="gallery-img-wrap">
              <img
                src={item.image}
                alt={item.title}
                width="600"
                height="354"
                loading="lazy"
                decoding="async"
                class="gallery-img"
              />
              <span class="photo-badge">{item.badge}</span>
              <span class="zoom-indicator-btn" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
              </span>
            </div>
            <div class="gallery-info">
              <h3 class="gallery-title">{item.title}</h3>
              <p class="gallery-desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Section Galeri Pelatihan (9 Foto Asli) -->
  <section class="mp-section" id="galeri-pelatihan">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Rekam Jejak Edukasi & Pelatihan</span>
        <h2 class="heading-lg">Galeri Pelatihan & Workshop Profesional</h2>
        <p>Dokumentasi penyelenggaraan seminar digital marketing, workshop UMKM, in-house training instansi pemerintahan, dan program literasi vokasi sekolah.</p>
      </div>

      <div class="real-gallery-grid">
        {pelatihanGallery.map((item) => (
          <div
            class="gallery-photo-card"
            data-gallery-item
            data-img={item.image}
            data-title={item.title}
            data-desc={item.desc}
            data-badge={item.badge}
            role="button"
            tabindex="0"
            aria-label={`Lihat foto ${item.title}`}
          >
            <div class="gallery-img-wrap">
              <img
                src={item.image}
                alt={item.title}
                width="600"
                height="354"
                loading="lazy"
                decoding="async"
                class="gallery-img"
              />
              <span class="photo-badge photo-badge--pelatihan">{item.badge}</span>
              <span class="zoom-indicator-btn" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
              </span>
            </div>
            <div class="gallery-info">
              <h3 class="gallery-title">{item.title}</h3>
              <p class="gallery-desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Section Standar Kualitas Portofolio (Impact Stats) -->
  <section class="mp-section mp-section--surface" id="standar-portofolio">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Nilai Lebih Portofolio</span>
        <h2 class="heading-lg">Standar Mutu Karya di PixxelPro</h2>
        <p>Mengapa portofolio alumni PixxelPro selalu diperhitungkan saat melamar kerja ke perusahaan teknologi?</p>
      </div>

      <div class="impact-stats-grid">
        {impactStats.map((stat) => (
          <div class="impact-card">
            <span class="impact-num">{stat.num}</span>
            <h3 class="impact-title">{stat.title}</h3>
            <p class="impact-desc">{stat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Section Alur Pembentukan Portofolio -->
  <section class="mp-section" id="alur-pengerjaan">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Metodologi Belajar</span>
        <h2 class="heading-lg">Tahapan Merancang Portofolio Nyata</h2>
        <p>Alur pembimbingan sistematis dari identifikasi masalah hingga hasil karya siap dipamerkan di CV dan LinkedIn.</p>
      </div>

      <div class="flow-steps-grid">
        {portfolioFlow.map((f) => (
          <div class="flow-step-card">
            <span class="flow-num">{f.step}</span>
            <h4 class="flow-title">{f.title}</h4>
            <p class="flow-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Unified Closing CTA Banner -->
  <CtaBanner
    eyebrow="Ingin Membangun Portofolio Nyata?"
    title="Tingkatkan Nilai Diri Anda dengan Karya Industri Riil"
    desc="Bergabunglah dalam program magang SMK atau internship mahasiswa di PixxelPro Kota Malang dan miliki portofolio profesional pertama Anda."
    waLabel="Konsultasi Magang Sekarang"
    waMessage="Halo PixxelPro, saya ingin bertanya tentang cara bergabung dan membangun portofolio proyek di PixxelPro."
  />

  <!-- Interactive Lightbox Modal for Real Galleries -->
  <div id="gallery-lightbox" class="gallery-lightbox" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="lightbox-overlay" id="lightbox-backdrop"></div>
    <div class="lightbox-container">
      <button class="lightbox-close-btn" id="lightbox-close" aria-label="Tutup pratinjau foto">&times;</button>
      
      <!-- Tombol Navigasi Panah Kiri & Kanan -->
      <button class="lightbox-nav-btn lightbox-nav-btn--prev" id="lightbox-prev" aria-label="Foto sebelumnya (Panah Kiri)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button class="lightbox-nav-btn lightbox-nav-btn--next" id="lightbox-next" aria-label="Foto berikutnya (Panah Kanan)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-media-wrap">
        <img id="lightbox-img" src="" alt="" />
      </div>

      <div class="lightbox-caption">
        <div class="lightbox-meta-row">
          <span class="lightbox-badge" id="lightbox-badge"></span>
          <span class="lightbox-counter" id="lightbox-counter">1 / 9</span>
        </div>
        <h4 id="lightbox-title" class="lightbox-title"></h4>
        <p id="lightbox-desc" class="lightbox-desc"></p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Interactive Portfolio Filtering
  function initPortfolioFilter() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.portfolio-item-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const filter = btn.getAttribute('data-filter');

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  // Interactive Lightbox for Galeri Magang & Pelatihan with Arrow Navigation
  function initGalleryLightbox() {
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxDesc = document.getElementById('lightbox-desc');
    const lightboxBadge = document.getElementById('lightbox-badge');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const backdrop = document.getElementById('lightbox-backdrop');

    if (!lightbox || !lightboxImg || !lightboxTitle || !lightboxDesc || !lightboxBadge) return;

    let currentItems: HTMLElement[] = [];
    let currentIndex = 0;

    function renderItem(index: number) {
      if (!currentItems.length) return;
      // Handle wrapping
      if (index < 0) {
        currentIndex = currentItems.length - 1;
      } else if (index >= currentItems.length) {
        currentIndex = 0;
      } else {
        currentIndex = index;
      }

      const card = currentItems[currentIndex];
      const img = card.getAttribute('data-img') || '';
      const title = card.getAttribute('data-title') || '';
      const desc = card.getAttribute('data-desc') || '';
      const badge = card.getAttribute('data-badge') || '';

      if (lightboxImg) {
        lightboxImg.style.opacity = '0.35';
        lightboxImg.src = img;
        lightboxImg.alt = title;
        lightboxImg.onload = () => {
          lightboxImg.style.opacity = '1';
        };
      }

      if (lightboxTitle) lightboxTitle.textContent = title;
      if (lightboxDesc) lightboxDesc.textContent = desc;
      if (lightboxBadge) lightboxBadge.textContent = badge;
      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentIndex + 1} / ${currentItems.length}`;
      }
    }

    function openModal(card: HTMLElement) {
      // Group items by current active section (e.g., galeri-magang or galeri-pelatihan)
      const parentSection = card.closest('section');
      if (parentSection) {
        currentItems = Array.from(parentSection.querySelectorAll<HTMLElement>('[data-gallery-item]'));
      } else {
        currentItems = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-item]'));
      }

      const foundIdx = currentItems.indexOf(card);
      currentIndex = foundIdx !== -1 ? foundIdx : 0;

      renderItem(currentIndex);

      lightbox?.classList.add('is-open');
      lightbox?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      lightbox?.classList.remove('is-open');
      lightbox?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (!lightbox?.classList.contains('is-open') && lightboxImg) {
          lightboxImg.src = '';
        }
      }, 200);
    }

    function showNext() {
      renderItem(currentIndex + 1);
    }

    function showPrev() {
      renderItem(currentIndex - 1);
    }

    const cards = document.querySelectorAll<HTMLElement>('[data-gallery-item]');
    cards.forEach((card) => {
      card.addEventListener('click', () => openModal(card));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal(card);
        }
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showPrev();
    });
    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showNext();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('is-open')) return;

      if (e.key === 'Escape') {
        closeModal();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        showNext();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        showPrev();
      }
    });
  }

  // Run on page load
  document.addEventListener('DOMContentLoaded', () => {
    initPortfolioFilter();
    initGalleryLightbox();
  });
</script>

