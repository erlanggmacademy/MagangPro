];

export interface GalleryPhoto {
  image: string;
  title: string;
  badge: string;
  desc: string;
}

const magangGallery: GalleryPhoto[] = [
  {
    image: '/images/portfolio/magang-2.webp',
    title: 'Praktik Lab & Riset SEO Siswa SMK',
    badge: 'PKL Vokasi',
    desc: 'Siswi SMKN 1 Purwosari fokus melakukan riset kata kunci dan optimasi konten digital marketing di lab komputer.'
  },
  {
    image: '/images/portfolio/magang-3.webp',
    title: 'Diskusi & Brainstorming Proyek Tim',
    badge: 'Kolaborasi Tim',
    desc: 'Peserta magang saling bertukar ide dan mereview progres kampanye digital marketing bersama.'
  },
  {
    image: '/images/portfolio/magang-4.webp',
    title: 'Produksi Desain Kreatif Siswa DKV',
    badge: 'DKV & Multimedia',
    desc: 'Sesi perancangan aset grafis promosi, feeds sosial media, dan identitas visual produk oleh tim DKV.'
  },
  {
    image: '/images/portfolio/magang-5.webp',
    title: 'Pengerjaan Proyek Riil Intensif',
    badge: 'Hands-On Project',
    desc: 'Aktivitas harian peserta magang mengerjakan penugasan proyek industri dengan pendampingan langsung mentor.'
  },
  {
    image: '/images/portfolio/magang-6.webp',
    title: 'Suasana Kerja Lab Magang Onsite',
    badge: 'Lab Industri',
    desc: 'Fasilitas kerja kondusif dengan workstation mandiri untuk memastikan jam terbang teknis maksimal.'
  },
  {
    image: '/images/portfolio/magang-7.webp',
    title: 'Peer Review & Koordinasi Tugas',
    badge: 'Team Review',
    desc: 'Sesi evaluasi rekan sejawat untuk memastikan kualitas kode dan output kampanye sebelum peluncuran.'
  },
  {
    image: '/images/portfolio/magang-8.webp',
    title: 'Praktik Bisnis Digital & Pemasaran',
    badge: 'Bisnis Digital',
    desc: 'Siswa jurusan pemasaran mempraktikkan strategi funneling dan manajemen leads secara langsung.'
  },
  {
    image: '/images/portfolio/magang-9.webp',
    title: 'Internship Mahasiswa Berbasis Proyek',
    badge: 'Mahasiswa MBKM',
    desc: 'Mahasiswa perguruan tinggi ternama di Malang menjalani program internship konversi SKS dan portofolio.'
  },
  {
    image: '/images/portfolio/magang-10.webp',
    title: 'Praktik Teknis TKJ & Administrasi Web',
    badge: 'TKJ & IT',
