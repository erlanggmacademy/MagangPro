---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const pageTitle = "Alur & Tata Cara Pendaftaran Magang di Malang | MagangPro";
const pageDescription = "Panduan lengkap tahapan pendaftaran program magang SMK dan internship mahasiswa di MagangPro Kota Malang. Proses cepat, transparan, dan tanpa biaya formulir tersembunyi.";

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Program Magang', href: '/program-magang' },
  { label: 'Alur Pendaftaran' },
];

const registrationSteps = [
  {
    step: '01',
    title: 'Konsultasi Kuota & Jadwal',
    tag: 'Langkah Pertama',
    desc: 'Hubungi Admin WhatsApp MagangPro (+62 895-6390-68080) untuk mengonfirmasi ketersediaan posisi dan bulan gelombang yang Anda rencanakan.',
    action: 'Konsultasikan jurusan, asal institusi (SMK/Universitas), dan durasi magang yang diinginkan.',
  },
  {
    step: '02',
    title: 'Pengajuan Berkas Resmi',
    tag: 'Verifikasi Dokumen',
    desc: 'Kirimkan berkas administratif berupa surat permohonan magang dari sekolah/dekanat kampus serta CV atau portofolio singkat (jika ada).',
    action: 'Berkas dikirim dalam bentuk dokumen PDF melalui WhatsApp resmi MagangPro.',
  },
  {
    step: '03',
    title: 'Penerbitan Surat Balasan',
    tag: 'Legalitas Penerimaan',
    desc: 'Tim MagangPro menerbitkan Surat Bukti Penerimaan resmi (LoA) bertanda tangan pimpinan untuk diserahkan kembali ke sekolah/kampus.',
    action: 'Surat balasan resmi diterbitkan cepat dalam 1–2 hari kerja setelah berkas diverifikasi.',
  },
  {
    step: '04',
    title: 'Onboarding & Pelaksanaan',
    tag: 'Mulai Praktik Riil',
    desc: 'Peserta hadir di lab onsite MagangPro di Mojolangu Malang untuk orientasi pengenalan mentor, instalasi tools kerja, dan pembagian project nyata.',
    action: 'Pelaksanaan magang berlangsung dengan bimbingan harian, asistensi laporan, hingga evaluasi sertifikat.',
  },
];

const documentRequirements = [
  {
    category: 'Untuk Siswa SMK / Vokasi',
    badge: 'Jalur PKL',
    items: [
      'Surat permohonan / pengantar PKL resmi dari pihak sekolah',
      'Fotokopi / scan Kartu Pelajar yang masih aktif',
      'Buku jurnal / logbook harian kegiatan dari sekolah (jika disediakan)',
      'Laptop pribadi untuk pengerjaan tugas proyek harian',
    ],
  },
  {
    category: 'Untuk Mahasiswa D3 / D4 / S1',
    badge: 'Jalur Internship',
    items: [
      'Surat pengantar permohonan magang dari dekanat / ketua program studi',
      'Curriculum Vitae (CV) singkat terbaru (format PDF)',
      'Transkrip nilai sementara atau kartu tanda mahasiswa (KTM)',
      'Laptop pribadi dengan spesifikasi memadai untuk bidang keahlian',
    ],
  },
];

const registerFaqs = [
  {
    q: 'Apakah ada biaya formulir pendaftaran magang di MagangPro?',
    a: 'Tidak ada biaya formulir pendaftaran. MagangPro berkomitmen menyediakan sarana belajar industri yang transparan bagi siswa dan mahasiswa terpilih.',
  },
  {
    q: 'Bolehkah berkonsultasi kuota sebelum surat dari kampus/sekolah keluar?',
    a: 'Sangat disarankan. Anda dapat berkonsultasi terlebih dahulu untuk memastikan slot kuota pada divisi yang diinginkan masih tersedia, sambil memproses surat permohonan resmi dari institusi pendidikan Anda.',
  },
  {
    q: 'Berapa lama proses penerbitan surat balasan penerimaan magang?',
    a: 'Surat balasan penerimaan magang (LoA) resmi biasanya kami terbitkan dalam 1 sampai 2 hari kerja setelah data dan surat pengantar dari sekolah/kampus kami terima secara lengkap.',
  },
  {
    q: 'Apakah bisa mendaftar secara berkelompok (tim rombongan satu sekolah)?',
    a: 'Bisa. Pendaftaran rombongan sekolah SMK (misalnya 2 hingga 4 siswa dalam satu jurusan) dapat dikoordinasikan langsung oleh guru pembimbing atau ketua kelompok melalui WhatsApp kami.',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- 1. Unified Page Banner -->
  <PageBanner
    pill="Panduan Registrasi"
    title="Alur Pendaftaran"
    description="Tahapan praktis pendaftaran magang SMK dan internship mahasiswa di MagangPro Kota Malang. Proses administrasi cepat, terarah, dan transparan."
    breadcrumbs={breadcrumbs}
  />

  <!-- 2. Section 4 Langkah Pendaftaran -->
  <section class="mp-section" id="tahapan-pendaftaran">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Tahapan Mudah</span>
        <h2 class="heading-lg">4 Langkah Sederhana Menjadi Bagian MagangPro</h2>
        <p>Seluruh proses komunikasi dan administrasi dirancang efisien agar memudahkan peserta maupun institusi pendidikan.</p>
      </div>

      <div class="reg-steps-flow">
        {registrationSteps.map((s) => (
          <div class="flow-card">
            <div class="flow-head">
              <span class="flow-step-num">{s.step}</span>
              <span class="flow-tag">{s.tag}</span>
            </div>

            <h3 class="flow-title">{s.title}</h3>
            <p class="flow-desc">{s.desc}</p>

            <div class="flow-action-note">
              <strong>Catatan:</strong> {s.action}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Section Dokumen & Berkas yang Disiapkan -->
  <section class="mp-section mp-section--surface" id="berkas-persyaratan">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Persiapan Berkas</span>
        <h2 class="heading-lg">Dokumen yang Perlu Anda Siapkan</h2>
        <p>Pastikan berkas-berkas berikut siap agar proses verifikasi dan penerbitan surat balasan berlangsung cepat.</p>
      </div>

      <div class="doc-req-grid">
        {documentRequirements.map((doc) => (
          <div class="doc-card">
            <div class="doc-card-head">
              <span class="doc-badge">{doc.badge}</span>
              <h3 class="doc-card-title">{doc.category}</h3>
            </div>

            <ul class="doc-list">
              {doc.items.map((item) => (
                <li>
                  <span class="doc-chk">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="device-note-box">
        <div class="device-note-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <div class="device-note-text">
          <strong>Catatan Kesiapan Perangkat Kerja Pribadi:</strong>
          <p>
            Peserta disarankan membawa laptop pribadi (disarankan prosesor minimum Core i3 / AMD Ryzen 3 dan RAM 8GB) agar mempermudah alur instalasi software kerja serta backup seluruh berkas proyek portofolio Anda.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Section FAQ Pendaftaran -->
  <section class="mp-section" id="faq-pendaftaran">
    <div class="mp-container">
      <div class="section-header text-center">
        <span class="eyebrow">Tanya Jawab Registrasi</span>
        <h2 class="heading-lg">Pertanyaan Seputar Pendaftaran</h2>
        <p>Informasi penting yang sering ditanyakan sebelum memulai proses pendaftaran magang.</p>
      </div>

      <div class="reg-faq-list">
        {registerFaqs.map((faq, idx) => (
          <details class="reg-faq-item" open={idx === 0}>
            <summary class="reg-faq-summary">
              <span class="reg-faq-q">{faq.q}</span>
              <span class="reg-faq-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </span>
            </summary>
            <div class="reg-faq-content">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Unified Closing CTA Banner -->
  <CtaBanner
    eyebrow="Siap Bergabung?"
    title="Mulai Langkah Magang Anda di MagangPro Hari Ini"
    desc="Hubungi admin resmi kami untuk mengonfirmasi ketersediaan posisi magang pada periode yang Anda rencanakan."
    waLabel="Daftar Magang via WhatsApp"
    waMessage="Halo MagangPro, saya ingin mendaftar program magang dan menanyakan alur pengajuan berkas."
  />
</BaseLayout>

<style>
  /* Steps Flow */
  .reg-steps-flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    max-width: 1180px;
    margin-inline: auto;
  }

  @media (max-width: 1024px) {
    .reg-steps-flow {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .reg-steps-flow {
      grid-template-columns: 1fr;
    }
  }

  .flow-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    padding: 28px 22px;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .flow-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(15, 23, 42, 0.08);
  }

  .flow-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .flow-step-num {
    font-family: var(--mp-font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--mp-red);
    line-height: 1;
  }

  .flow-tag {
    background: #f1f5f9;
    color: #475569;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .flow-title {
    font-family: var(--mp-font-heading);
    font-size: 1.18rem;
    color: #0f172a;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .flow-desc {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 18px;
    flex-grow: 1;
  }

  .flow-action-note {
    background: #f8fafc;
    border-left: 3px solid var(--mp-red);
    padding: 10px 12px;
    border-radius: 0 8px 8px 0;
    font-size: 0.78rem;
    color: #334155;
    line-height: 1.5;
  }

  .flow-action-note strong {
    color: #0f172a;
  }

  /* Document Requirements Grid */
  .doc-req-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    max-width: 1040px;
    margin-inline: auto;
    margin-bottom: 32px;
  }

  @media (max-width: 820px) {
    .doc-req-grid {
      grid-template-columns: 1fr;
    }
  }

  .doc-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    padding: clamp(26px, 3.5vw, 36px);
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
  }

  .doc-card-head {
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #f1f5f9;
  }

  .doc-badge {
    display: inline-block;
    background: rgba(198, 40, 40, 0.1);
    color: var(--mp-red);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 9999px;
    margin-bottom: 10px;
  }

  .doc-card-title {
    font-family: var(--mp-font-heading);
    font-size: 1.3rem;
    color: #0f172a;
    line-height: 1.3;
    margin: 0;
  }

  .doc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .doc-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.88rem;
    color: #334155;
    line-height: 1.55;
  }

  .doc-chk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(22, 163, 74, 0.12);
    color: #16a34a;
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .device-note-box {
    max-width: 1040px;
    margin-inline: auto;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 22px 24px;
    display: flex;
    align-items: flex-start;
    gap: 18px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
  }

  .device-note-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(198, 40, 40, 0.08);
    color: var(--mp-red);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .device-note-text strong {
    font-size: 0.95rem;
    color: #0f172a;
    display: block;
    margin-bottom: 4px;
  }

  .device-note-text p {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  /* FAQ Accordion */
  .reg-faq-list {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .reg-faq-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .reg-faq-item:hover {
    border-color: rgba(198, 40, 40, 0.3);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
  }

  .reg-faq-item[open] {
    border-color: var(--mp-red);
    box-shadow: 0 6px 20px rgba(198, 40, 40, 0.08);
  }

  .reg-faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    cursor: pointer;
    font-family: var(--mp-font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: #0f172a;
    list-style: none;
    user-select: none;
  }

  .reg-faq-summary::-webkit-details-marker {
    display: none;
  }

  .reg-faq-q {
    flex-grow: 1;
    padding-right: 16px;
    text-align: left;
  }

  .reg-faq-item[open] .reg-faq-q {
    color: var(--mp-red);
  }

  .reg-faq-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f1f5f9;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .reg-faq-icon svg {
    transition: transform 0.25s ease;
  }

  .reg-faq-item[open] .reg-faq-icon svg {
    transform: rotate(45deg);
  }

  .reg-faq-item[open] .reg-faq-icon {
    background: rgba(198, 40, 40, 0.1);
    color: var(--mp-red);
  }

  .reg-faq-content {
    padding: 0 24px 22px;
    font-size: 0.92rem;
    color: #475569;
    line-height: 1.7;
    text-align: left;
  }

  .reg-faq-content p {
    margin: 0;
  }
</style>
